@page
@model IndexModel
@{
    Layout = null;
    ViewData["Title"] = "Home";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <title>AI Interview Platform</title>

    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700" rel="stylesheet">
    <link href="https://use.fontawesome.com/releases/v5.0.6/css/all.css" rel="stylesheet">

    <link href="/assets/css/nucleo-icons.css" rel="stylesheet" />
    <link href="/assets/css/nucleo-svg.css" rel="stylesheet" />
    <link href="/assets/css/font-awesome.css" rel="stylesheet" />
    <link href="/assets/css/argon-design-system.css?v=1.2.2" rel="stylesheet" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Open Sans', sans-serif;
            overflow-x: hidden;
        }

        /* Video Background */
        .video-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            overflow: hidden;
        }

        .video-bg video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .video-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(10, 10, 26, 0.7);
            backdrop-filter: blur(5px);
        }

        /* Navbar */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            padding: 15px 0;
            background: rgba(10, 10, 26, 0.8);
            backdrop-filter: blur(10px);
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            flex-shrink: 0;
        }

        .navbar-brand img {
            height: 80px;
            width: auto;
        }

        .navbar-brand .brand-text {
            font-weight: 700;
            font-size: 1.1rem;
            margin-left: 10px;
            color: #fff;
        }

        .navbar-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            gap: 20px;
        }

        .navbar-center {
            display: flex;
            align-items: center;
            justify-content: center;
            flex: 1;
        }

        .navbar-auth-buttons {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
        }

        /* Pill Navigation */
        .pill-radio-container {
            --main-color: #ff6ec4;
            --secondary-color: #7873f5;
            --text-color: #ddd;
            --pill-bg: rgba(26, 26, 26, 0.6);
            --total-options: 5;

            display: flex;
            position: relative;
            background: var(--pill-bg);
            border-radius: 3rem;
            padding: 0.5rem;
            gap: 0.5rem;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.5) inset;
            width: fit-content;
            backdrop-filter: blur(10px);
        }

        .pill-radio-container input {
            display: none;
        }

        .pill-radio-container label {
            position: relative;
            padding: 0.6rem 1.2rem;
            border-radius: 3rem;
            cursor: pointer;
            font-weight: 600;
            color: var(--text-color);
            transition: color 0.3s ease-in-out;
            z-index: 2;
            white-space: nowrap;
            font-size: 14px;
        }

        .pill-radio-container input:checked + label {
            color: #fff;
        }

        .pill-radio-container label:hover {
            color: var(--main-color);
        }

        .pill-indicator {
            position: absolute;
            bottom: 5px;
            left: 0;
            height: 4px;
            width: calc(100% / var(--total-options));
            background: linear-gradient(
                to right,
                var(--main-color),
                var(--secondary-color)
            );
            border-radius: 2px;
            transition: transform 0.3s ease-in-out;
            z-index: 1;
        }

        /* Sliding effect for pill navigation */
        #pill-home:checked ~ .pill-indicator {
            transform: translateX(0%);
        }
        #pill-profile:checked ~ .pill-indicator {
            transform: translateX(100%);
        }
        #pill-resume:checked ~ .pill-indicator {
            transform: translateX(200%);
        }
        #pill-interview:checked ~ .pill-indicator {
            transform: translateX(300%);
        }
        #pill-roadmap:checked ~ .pill-indicator {
            transform: translateX(400%);
        }

        /* Action Buttons with Glow Effect */
        .button {
            position: relative;
            width: 120px;
            height: 40px;
            background-color: #000;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            flex-direction: column;
            border: none;
            padding: 12px;
            gap: 12px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            font-size: 14px;
            text-decoration: none;
            overflow: hidden;
            text-align: center;
            line-height: 1;
        }

        .button::before {
            content: '';
            position: absolute;
            inset: 0;
            left: -4px;
            top: -1px;
            margin: auto;
            width: 128px;
            height: 48px;
            border-radius: 10px;
            background: linear-gradient(-45deg, #e81cff 0%, #40c9ff 100%);
            z-index: -10;
            pointer-events: none;
            transition: all 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .button::after {
            content: "";
            z-index: -1;
            position: absolute;
            inset: 0;
            background: linear-gradient(-45deg, #fc00ff 0%, #00dbde 100%);
            transform: translate3d(0, 0, 0) scale(0.95);
            filter: blur(20px);
        }

        .button:hover::after {
            filter: blur(30px);
        }

        .button:hover::before {
            transform: rotate(-180deg);
        }

        .button:active::before {
            scale: 0.7;
        }

        /* Button hover text effect */
        .button span {
            position: relative;
            z-index: 1;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .user-name {
            color: #fff;
            font-weight: 600;
        }

        /* Hero Section */
        .hero-section {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 120px 20px 60px;
        }

        .hero-content {
            max-width: 800px;
        }

        .hero-logo {
            width: 200px;
            height: 200px;
            border-radius: 50%;
            object-fit: contain;
            margin-bottom: 30px;
            box-shadow: 0 0 30px rgba(255, 110, 196, 0.3);
        }

        .hero-title {
            font-size: 3.5rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 20px;
            text-shadow: 0 0 30px rgba(255, 110, 196, 0.3);
        }

        .hero-subtitle {
            font-size: 1.5rem;
            color: rgba(255, 255, 255, 0.9);
            margin-bottom: 30px;
            font-weight: 400;
        }

        .hero-description {
            font-size: 1.1rem;
            color: rgba(255, 255, 255, 0.7);
            margin-bottom: 40px;
            line-height: 1.8;
        }

        .hero-buttons {
            display: flex;
            gap: 20px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .hero-btn {
            padding: 15px 35px;
            border-radius: 50px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .hero-btn-primary {
            background: linear-gradient(135deg, #ff6ec4, #7873f5);
            color: #fff;
        }

        .hero-btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(255, 110, 196, 0.4);
        }

        .hero-btn-secondary {
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
            border: 2px solid rgba(255, 255, 255, 0.3);
        }

        .hero-btn-secondary:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateY(-3px);
        }

        /* Features Section */
        .features-section {
            padding: 80px 20px;
            background: rgba(10, 10, 26, 0.9);
            backdrop-filter: blur(10px);
        }

        .section-title {
            text-align: center;
            color: #fff;
            font-size: 2.5rem;
            margin-bottom: 50px;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .feature-card {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 40px;
            text-align: center;
            transition: all 0.3s ease;
        }

        .feature-card:hover {
            transform: translateY(-10px);
            border-color: rgba(255, 110, 196, 0.5);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
        }

        .feature-icon {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 25px;
            font-size: 2rem;
        }

        .feature-icon.pink {
            background: linear-gradient(135deg, rgba(255, 110, 196, 0.2), rgba(120, 115, 245, 0.2));
            color: #ff6ec4;
        }

        .feature-icon.blue {
            background: linear-gradient(135deg, rgba(64, 201, 255, 0.2), rgba(0, 219, 222, 0.2));
            color: #40c9ff;
        }

        .feature-icon.purple {
            background: linear-gradient(135deg, rgba(120, 115, 245, 0.2), rgba(232, 28, 255, 0.2));
            color: #7873f5;
        }

        .feature-title {
            color: #fff;
            font-size: 1.3rem;
            margin-bottom: 15px;
            font-weight: 600;
        }

        .feature-description {
            color: rgba(255, 255, 255, 0.7);
            line-height: 1.7;
        }

        /* Footer */
        footer {
            background: rgba(10, 10, 26, 0.95);
            padding: 40px 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .footer-content {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .footer-copyright {
            color: rgba(255, 255, 255, 0.6);
            font-size: 14px;
        }

        .footer-links {
            display: flex;
            gap: 30px;
        }

        .footer-links a {
            color: rgba(255, 255, 255, 0.6);
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .footer-links a:hover {
            color: #ff6ec4;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .pill-radio-container {
                flex-wrap: wrap;
                justify-content: center;
                --total-options: 3;
            }

            .pill-indicator {
                display: none;
            }

            .hero-title {
                font-size: 2.5rem;
            }

            .hero-logo {
                width: 100px;
                height: 100px;
            }

            .navbar-buttons {
                display: none;
            }

            .user-info {
                display: none;
            }

            .footer-content {
                flex-direction: column;
                text-align: center;
            }
        }
    </style>
</head>

<body>
    <!-- Video Background -->
    <div class="video-bg">
        <video autoplay muted loop playsinline>
            <source src="/videos/videoBackGoundHome.mp4" type="video/mp4">
        </video>
        <div class="video-overlay"></div>
    </div>

    <!-- Navbar -->
    <nav class="navbar">
        <div class="container">
            <div class="navbar-container">
                <a class="navbar-brand" href="/">
                    <img src="/img/logo.png" alt="Logo">
                </a>

                <div class="navbar-center">
                    <div class="pill-radio-container">
                        <input type="radio" name="pill" id="pill-home" checked>
                        <label for="pill-home" onclick="window.location.href='/'">Home</label>

                        <input type="radio" name="pill" id="pill-profile">
                        <label for="pill-profile" onclick="window.location.href='/Profile'">Profile</label>

                        <input type="radio" name="pill" id="pill-resume">
                        <label for="pill-resume" onclick="window.location.href='/Resume'">Resume</label>

                        <input type="radio" name="pill" id="pill-interview">
                        <label for="pill-interview">Interview</label>

                        <input type="radio" name="pill" id="pill-roadmap">
                        <label for="pill-roadmap">Roadmap</label>

                        <div class="pill-indicator"></div>
                    </div>
                </div>

                <div class="user-info">
                    <span id="currentUserName" class="user-name"></span>
                    <a id="logoutButton" href="#" onclick="logout(); return false;" class="button" style="display: none;">
                        Logout
                    </a>
                </div>

                <div class="navbar-auth-buttons">
                    <a id="loginButtonNew" href="/Auth/Login" class="button">
                        Login
                    </a>
                    <a id="registerButtonNew" href="/Auth/Register" class="button">
                        Register
                    </a>
                    <a id="logoutButtonNew" href="#" onclick="logout(); return false;" class="button" style="display: none;">
                        Logout
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="hero-content">
            <img src="/img/logo.png" alt="AI Interview Platform" class="hero-logo">
            
            <h1 class="hero-title">AI Interview Platform</h1>
            
            <p class="hero-subtitle">Practice smarter. Interview better.</p>
            
            <p class="hero-description">
                Upload your resume, analyze skill gaps, practice mock interviews,
                and improve your readiness score with AI-powered feedback.
            </p>

            <div class="hero-buttons">
                <a href="/Auth/Register" class="hero-btn hero-btn-primary">
                    <i class="fas fa-rocket mr-2"></i> Get Started
                </a>
                <a href="/Profile" class="hero-btn hero-btn-secondary">
                    <i class="fas fa-user mr-2"></i> My Profile
                </a>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="features-section">
        <h2 class="section-title">Our Features</h2>
        
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon pink">
                    <i class="ni ni-chart-bar-32"></i>
                </div>
                <h3 class="feature-title">Resume & Job Analysis</h3>
                <p class="feature-description">
                    Compare your resume with target job descriptions and discover
                    matched skills, missing skills, and improvement areas.
                </p>
            </div>

            <div class="feature-card">
                <div class="feature-icon blue">
                    <i class="ni ni-chat-round"></i>
                </div>
                <h3 class="feature-title">AI Mock Interview</h3>
                <p class="feature-description">
                    Practice behavioral and technical interview questions tailored
                    to your target role with real-time AI feedback.
                </p>
            </div>

            <div class="feature-card">
                <div class="feature-icon purple">
                    <i class="ni ni-map-big"></i>
                </div>
                <h3 class="feature-title">Personalized Roadmap</h3>
                <p class="feature-description">
                    Follow a learning roadmap generated from your weaknesses and
                    track progress over time with measurable goals.
                </p>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="footer-content">
            <div class="footer-copyright">
                &copy; 2026 AI Interview Platform
            </div>
            <div class="footer-links">
                <a href="/">Home</a>
                <a href="/Profile">Profile</a>
                <a href="/Auth/Login">Login</a>
            </div>
        </div>
    </footer>

    <script src="/assets/js/core/jquery.min.js"></script>
    <script src="/assets/js/core/popper.min.js"></script>
    <script src="/assets/js/core/bootstrap.min.js"></script>
    <script src="/assets/js/argon-design-system.min.js?v=1.2.2"></script>
    <script src="/js/api.js"></script>
    <script src="/js/auth.js"></script>
    <script src="/js/site.js"></script>

    <script>
        // Handle auth buttons visibility
        document.addEventListener('DOMContentLoaded', function() {
            const token = localStorage.getItem('token');
            const user = localStorage.getItem('user');

            // New navbar buttons
            const loginBtnNew = document.getElementById('loginButtonNew');
            const registerBtnNew = document.getElementById('registerButtonNew');
            const logoutBtnNew = document.getElementById('logoutButtonNew');

            // Old elements
            const loginBtn = document.getElementById('loginButton');
            const registerBtn = document.getElementById('registerButton');
            const logoutBtn = document.getElementById('logoutButton');
            const currentUserName = document.getElementById('currentUserName');

            if (token && user) {
                // Logged in - show logout, hide login/register
                if (loginBtnNew) loginBtnNew.style.display = 'none';
                if (registerBtnNew) registerBtnNew.style.display = 'none';
                if (logoutBtnNew) logoutBtnNew.style.display = 'flex';

                if (loginBtn) loginBtn.style.display = 'none';
                if (registerBtn) registerBtn.style.display = 'none';
                if (logoutBtn) logoutBtn.style.display = 'inline-flex';
                if (currentUserName) {
                    try {
                        const userData = JSON.parse(user);
                        currentUserName.textContent = userData.fullName || userData.email || 'User';
                    } catch (e) {
                        currentUserName.textContent = 'User';
                    }
                }
            } else {
                // Logged out - show login/register, hide logout
                if (loginBtnNew) loginBtnNew.style.display = 'flex';
                if (registerBtnNew) registerBtnNew.style.display = 'flex';
                if (logoutBtnNew) logoutBtnNew.style.display = 'none';

                if (loginBtn) loginBtn.style.display = 'inline-flex';
                if (registerBtn) registerBtn.style.display = 'inline-flex';
                if (logoutBtn) logoutBtn.style.display = 'none';
                if (currentUserName) currentUserName.textContent = '';
            }
        });
    </script>
</body>
</html>
