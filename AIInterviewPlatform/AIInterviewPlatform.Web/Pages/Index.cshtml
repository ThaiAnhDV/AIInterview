@page
@model IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Dashboard";
}

<style>
    .dashboard-container {
        padding: 30px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .dashboard-header {
        margin-bottom: 30px;
    }

    .dashboard-welcome {
        color: #fff;
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .dashboard-date {
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.9rem;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .stat-card {
        background: rgba(25, 25, 50, 0.8);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 16px;
        padding: 22px;
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .stat-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        border-radius: 4px 0 0 4px;
    }

    .stat-card.pink::before { background: linear-gradient(180deg, #ff6ec4, #7873f5); }
    .stat-card.blue::before { background: linear-gradient(180deg, #40c9ff, #00dbde); }
    .stat-card.purple::before { background: linear-gradient(180deg, #7873f5, #e81cff); }
    .stat-card.green::before { background: linear-gradient(180deg, #4caf50, #8bc34a); }

    .stat-card:hover {
        transform: translateY(-3px);
        border-color: rgba(255, 255, 255, 0.12);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
    }

    .stat-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 15px;
    }

    .stat-icon {
        width: 45px;
        height: 45px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .stat-icon.pink { background: rgba(255, 110, 196, 0.15); color: #ff6ec4; }
    .stat-icon.blue { background: rgba(64, 201, 255, 0.15); color: #40c9ff; }
    .stat-icon.purple { background: rgba(120, 115, 245, 0.15); color: #7873f5; }
    .stat-icon.green { background: rgba(76, 175, 80, 0.15); color: #4caf50; }

    .stat-trend {
        font-size: 11px;
        font-weight: 600;
        padding: 4px 8px;
        border-radius: 20px;
    }

    .stat-trend.up {
        background: rgba(76, 175, 80, 0.15);
        color: #4caf50;
    }

    .stat-trend.neutral {
        background: rgba(255, 255, 255, 0.08);
        color: rgba(255, 255, 255, 0.6);
    }

    .stat-value {
        color: #fff;
        font-size: 1.6rem;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .stat-label {
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .section-title {
        color: #fff;
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .section-title i {
        color: #ff6ec4;
    }

    .quick-actions {
        margin-bottom: 30px;
    }

    .actions-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
    }

    .action-btn {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 14px 20px;
        background: linear-gradient(45deg, #0ce39a, #69007f, #fc0987);
        border-radius: 12px;
        font-size: 0.9rem;
        font-weight: 600;
        color: #fff;
        text-decoration: none;
        border: none;
        cursor: pointer;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .action-btn span {
        position: relative;
        z-index: 1;
    }

    .action-btn::before {
        content: "";
        position: absolute;
        inset: 2px;
        background: rgba(25, 25, 50, 0.95);
        border-radius: 10px;
        transition: 0.3s;
    }

    .action-btn:hover::before {
        opacity: 0.85;
    }

    .action-btn::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(45deg, #0ce39a, #69007f, #fc0987);
        border-radius: 10px;
        transition: 0.3s;
        opacity: 0;
        filter: blur(15px);
    }

    .action-btn:hover {
        transform: translateY(-2px);
    }

    .action-btn:hover::after {
        opacity: 1;
    }

    .action-btn i {
        position: relative;
        z-index: 1;
        font-size: 1rem;
    }

    .content-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 25px;
    }

    .main-content-card {
        background: rgba(25, 25, 50, 0.7);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 16px;
        padding: 25px;
        margin-bottom: 30px;
    }

    .activity-card {
        background: rgba(30, 30, 60, 0.5);
        border-radius: 12px;
        padding: 20px;
    }

    .activity-card h4 {
        color: #fff;
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .activity-card h4 i {
        color: #ff6ec4;
    }

    .activity-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .activity-item:last-child {
        border-bottom: none;
    }

    .activity-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        flex-shrink: 0;
    }

    .activity-icon.resume { background: rgba(255, 110, 196, 0.15); color: #ff6ec4; }
    .activity-icon.job { background: rgba(64, 201, 255, 0.15); color: #40c9ff; }
    .activity-icon.interview { background: rgba(120, 115, 245, 0.15); color: #7873f5; }
    .activity-icon.roadmap { background: rgba(76, 175, 80, 0.15); color: #4caf50; }

    .activity-content {
        flex: 1;
    }

    .activity-title {
        color: #fff;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 3px;
    }

    .activity-time {
        color: rgba(255, 255, 255, 0.4);
        font-size: 0.75rem;
    }

    .tips-card {
        background: rgba(30, 30, 60, 0.5);
        border-radius: 12px;
        padding: 20px;
    }

    .tips-card h4 {
        color: #fff;
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .tips-card h4 i {
        color: #40c9ff;
    }

    .tip-item {
        padding: 12px;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 10px;
        margin-bottom: 10px;
        border-left: 3px solid #ff6ec4;
    }

    .tip-item:last-child {
        margin-bottom: 0;
    }

    .tip-item p {
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.8rem;
        line-height: 1.5;
        margin: 0;
    }

    @@media (max-width: 1200px) {
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }
        .actions-grid {
            grid-template-columns: repeat(2, 1fr);
        }
        .content-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }
        .actions-grid {
            grid-template-columns: 1fr;
        }
        .dashboard-welcome {
            font-size: 1.4rem;
        }
        .dashboard-container {
            padding: 20px 15px;
        }
    }
</style>

<div class="dashboard-container">
    <!-- Dashboard Header -->
    <div class="dashboard-header">
        <h1 class="dashboard-welcome">Welcome back<span id="welcomeSuffix"></span></h1>
        <p class="dashboard-date" id="currentDate"></p>
    </div>

    <!-- Stats Cards -->
    <div class="stats-grid">
        <div class="stat-card pink">
            <div class="stat-header">
                <div class="stat-icon pink">
                    <i class="fas fa-file-alt"></i>
                </div>
                <span class="stat-trend neutral">Status</span>
            </div>
            <div class="stat-value" id="statResumes">0</div>
            <div class="stat-label">Uploaded Resumes</div>
        </div>

        <div class="stat-card blue">
            <div class="stat-header">
                <div class="stat-icon blue">
                    <i class="fas fa-bullseye"></i>
                </div>
                <span class="stat-trend neutral">Tracking</span>
            </div>
            <div class="stat-value" id="statTargetJobs">0</div>
            <div class="stat-label">Target Jobs</div>
        </div>

        <div class="stat-card purple">
            <div class="stat-header">
                <div class="stat-icon purple">
                    <i class="fas fa-comments"></i>
                </div>
                <span class="stat-trend up"><i class="fas fa-arrow-up mr-1"></i>New</span>
            </div>
            <div class="stat-value" id="statInterviews">0</div>
            <div class="stat-label">Interview Sessions</div>
        </div>

        <div class="stat-card green">
            <div class="stat-header">
                <div class="stat-icon green">
                    <i class="fas fa-chart-line"></i>
                </div>
                <span class="stat-trend neutral">Score</span>
            </div>
            <div class="stat-value" id="statReadiness">0%</div>
            <div class="stat-label">Readiness Score</div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="quick-actions">
        <h3 class="section-title">
            <i class="fas fa-bolt"></i> Quick Actions
        </h3>
        <div class="actions-grid">
            <a href="/Resume" class="action-btn">
                <i class="fas fa-cloud-upload-alt"></i>
                <span>Upload Resume</span>
            </a>
            <a href="/TargetJob" class="action-btn">
                <i class="fas fa-plus-circle"></i>
                <span>Create Target Job</span>
            </a>
            <a href="/Interview" class="action-btn">
                <i class="fas fa-play-circle"></i>
                <span>Start Interview</span>
            </a>
            <a href="/Roadmap" class="action-btn">
                <i class="fas fa-route"></i>
                <span>View Roadmap</span>
            </a>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content-card">
        <div class="content-grid">
            <!-- Recent Activity -->
            <div class="activity-card">
                <h4><i class="fas fa-history"></i> Recent Activity</h4>
                
                <div class="activity-item">
                    <div class="activity-icon resume">
                        <i class="fas fa-file-alt"></i>
                    </div>
                    <div class="activity-content">
                        <div class="activity-title">Resume uploaded successfully</div>
                        <div class="activity-time">Just now</div>
                    </div>
                </div>

                <div class="activity-item">
                    <div class="activity-icon job">
                        <i class="fas fa-bullseye"></i>
                    </div>
                    <div class="activity-content">
                        <div class="activity-title">Target job created</div>
                        <div class="activity-time">2 hours ago</div>
                    </div>
                </div>

                <div class="activity-item">
                    <div class="activity-icon interview">
                        <i class="fas fa-comments"></i>
                    </div>
                    <div class="activity-content">
                        <div class="activity-title">Mock interview completed</div>
                        <div class="activity-time">Yesterday</div>
                    </div>
                </div>

                <div class="activity-item">
                    <div class="activity-icon roadmap">
                        <i class="fas fa-map"></i>
                    </div>
                    <div class="activity-content">
                        <div class="activity-title">Learning roadmap generated</div>
                        <div class="activity-time">3 days ago</div>
                    </div>
                </div>
            </div>

            <!-- Tips Section -->
            <div class="tips-card">
                <h4><i class="fas fa-lightbulb"></i> Interview Tips</h4>
                
                <div class="tip-item">
                    <p>Upload your resume and match it with target job descriptions to identify skill gaps.</p>
                </div>
                
                <div class="tip-item">
                    <p>Practice with AI mock interviews to build confidence before your real interviews.</p>
                </div>
                
                <div class="tip-item">
                    <p>Follow your personalized learning roadmap to improve your readiness score.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/api.js"></script>
    <script src="~/js/auth.js"></script>
    <script src="~/js/site.js"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Set current date
            const dateEl = document.getElementById('currentDate');
            const now = new Date();
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            if (dateEl) dateEl.textContent = now.toLocaleDateString('en-US', options);

            // Welcome message
            const welcomeSuffix = document.getElementById('welcomeSuffix');
            const user = localStorage.getItem('user');
            if (user && welcomeSuffix) {
                try {
                    const userData = JSON.parse(user);
                    const displayName = userData.fullName || userData.email || '';
                    if (displayName) {
                        welcomeSuffix.textContent = ', ' + displayName.split(' ')[0];
                    }
                } catch (e) {}
            }
        });
    </script>
}
