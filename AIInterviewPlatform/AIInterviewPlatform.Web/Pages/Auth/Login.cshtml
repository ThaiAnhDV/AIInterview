                    <form role="form" onsubmit="event.preventDefault(); login();">
                        <div class="mt-5">
                            <label for="loginEmail" class="font-semibold text-sm text-gray-400 pb-1 block">E-mail</label>
                            <input id="loginEmail"
                                   type="email"
                                   placeholder="you@example.com"
                                   class="border rounded-lg px-3 py-2 mt-1 mb-5 text-sm w-full bg-gray-700 text-white border-gray-600 focus:border-blue-500 focus:ring-4 focus:ring-blue-500 focus:outline-none"
                                   required>

                            <label for="loginPassword" class="font-semibold text-sm text-gray-400 pb-1 block">Password</label>
                            <input id="loginPassword"
                                   type="password"
                                   placeholder="••••••••"
                                   class="border rounded-lg px-3 py-2 mt-1 mb-5 text-sm w-full bg-gray-700 text-white border-gray-600 focus:border-blue-500 focus:ring-4 focus:ring-blue-500 focus:outline-none"
                                   required>
                        </div>

                        <div class="text-right mb-4">
                            <a href="#" class="text-xs font-semibold text-gray-500 hover:text-gray-400 cursor-pointer">
                                Forgot Password?
                            </a>
                        </div>

                        <div class="flex justify-center items-center">
                            <div class="w-full">
                                <button type="button"
                                        class="flex items-center justify-center py-2 px-20 bg-white hover:bg-gray-200 focus:ring-blue-500 focus:ring-offset-blue-200 text-gray-700 w-full transition ease-in duration-200 text-center text-base font-semibold shadow-md focus:outline-none focus:ring-2 focus:ring-offset-2 rounded-lg">
                                    <svg viewBox="0 0 24 24" height="25" width="25" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
