@page
@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <title>Login - AI Interview Platform</title>

    <link rel="apple-touch-icon" sizes="76x76" href="/assets/img/apple-icon.png">
    <link rel="icon" type="image/png" href="/assets/img/favicon.png">

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="/css/site.css?v=3" rel="stylesheet" />
    <style>
        /* Login loading – inline to avoid Tailwind/cache conflicts */
        #login-loading-overlay {
            position: fixed !important;
            inset: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            z-index: 100000 !important;
            display: none !important;
            align-items: center !important;
            justify-content: center !important;
            background: rgba(0, 0, 0, 0.6) !important;
            backdrop-filter: blur(4px);
            pointer-events: all;
        }

        #login-loading-overlay.is-active {
            display: flex !important;
        }

        #login-loading-overlay .login-loading-content {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 1.25rem;
            perspective: 1000px;
        }

        #login-loading-overlay .login-loading-text {
            color: #e5e7eb;
            font-size: 0.95rem;
            font-weight: 500;
            margin: 0;
            text-align: center;
        }

        #login-loading-overlay .cube-loader {
            position: relative;
            width: 75px;
            height: 75px;
            transform-style: preserve-3d;
            transform: rotateX(-30deg);
            animation: login-cube-animate 4s linear infinite;
        }

        @@keyframes login-cube-animate {
            0% { transform: rotateX(-30deg) rotateY(0deg); }
            100% { transform: rotateX(-30deg) rotateY(360deg); }
        }

        #login-loading-overlay .cube-loader .cube-wrapper {
            position: absolute;
            width: 100%;
            height: 100%;
            transform-style: preserve-3d;
        }

        #login-loading-overlay .cube-loader .cube-wrapper .cube-span {
            position: absolute;
            display: block;
            width: 100%;
            height: 100%;
            transform: rotateY(calc(90deg * var(--i))) translateZ(37.5px);
            background: linear-gradient(
                to bottom,
                hsl(330, 3.13%, 25.1%) 0%,
                hsl(177.27, 21.71%, 32.06%) 5.5%,
                hsl(176.67, 34.1%, 36.88%) 12.1%,
                hsl(176.61, 42.28%, 40.7%) 19.6%,
                hsl(176.63, 48.32%, 43.88%) 27.9%,
                hsl(176.66, 53.07%, 46.58%) 36.6%,
                hsl(176.7, 56.94%, 48.91%) 45.6%,
                hsl(176.74, 62.39%, 50.91%) 54.6%,
                hsl(176.77, 69.86%, 52.62%) 63.4%,
                hsl(176.8, 76.78%, 54.08%) 71.7%,
                hsl(176.83, 83.02%, 55.29%) 79.4%,
                hsl(176.85, 88.44%, 56.28%) 86.2%,
                hsl(176.86, 92.9%, 57.04%) 91.9%,
                hsl(176.88, 96.24%, 57.59%) 96.3%,
                hsl(176.88, 98.34%, 57.93%) 99%,
                hsl(176.89, 99.07%, 58.04%) 100%
            );
        }

        #login-loading-overlay .cube-top {
            position: absolute;
            width: 75px;
            height: 75px;
            background: hsl(330, 3.13%, 25.1%);
            transform: rotateX(90deg) translateZ(37.5px);
            transform-style: preserve-3d;
        }

        #login-loading-overlay .cube-top::before {
            content: '';
            position: absolute;
            width: 75px;
            height: 75px;
            background: hsl(176.61, 42.28%, 40.7%);
            transform: translateZ(-90px);
            filter: blur(10px);
            box-shadow: 0 0 10px #323232,
                0 0 20px hsl(176.61, 42.28%, 40.7%),
                0 0 30px #323232,
                0 0 40px hsl(176.61, 42.28%, 40.7%);
        }
    </style>
</head>

<body class="login-page">

    <div class="auth-video-bg" aria-hidden="true">
        <video autoplay muted loop playsinline>
            <source src="/videos/auth-background.mp4" type="video/mp4">
            <source src="/videos/auth-background.webm" type="video/webm">
        </video>
        <div class="auth-video-overlay"></div>
    </div>

    <main class="login-shell min-h-screen flex items-center justify-center px-4 py-8">
        <div class="relative py-3 sm:max-w-xl sm:mx-auto w-full">
            <div class="relative px-4 py-10 bg-black mx-8 md:mx-0 shadow rounded-3xl sm:p-10">
                <div class="max-w-md mx-auto text-white">
