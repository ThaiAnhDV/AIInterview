@page
@model AIInterviewPlatform.Web.Pages.Roadmap.IndexModel

@{
    ViewData["Title"] = "Learning Roadmap";
}

<style>
    /* ===== ROADMAP PAGE STYLES ===== */
    .roadmap-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 24px;
    }

    /* Page Header */
    .roadmap-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 32px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .roadmap-header h1 {
        font-size: 1.75rem;
        font-weight: 700;
        color: #fff;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .roadmap-header h1 i {
        background: linear-gradient(135deg, #ff6ec4, #7873f5);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    /* Generate Section */
    .generate-section {
        background: rgba(25, 25, 50, 0.8);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 32px;
    }

    .generate-section h3 {
        font-size: 1rem;
        font-weight: 600;
        color: #fff;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .generate-form {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        align-items: flex-end;
    }

    .generate-form .form-group {
        flex: 1;
        min-width: 200px;
        margin: 0;
    }

    .generate-form .btn {
        white-space: nowrap;
    }

    /* Roadmap Cards Container */
    .roadmaps-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 20px;
        margin-bottom: 32px;
    }

    .roadmap-card {
        background: rgba(25, 25, 50, 0.8);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        padding: 20px;
        transition: all 0.3s ease;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

    .roadmap-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(135deg, #ff6ec4, #7873f5);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .roadmap-card:hover {
        transform: translateY(-4px);
        border-color: rgba(255, 110, 196, 0.3);
        box-shadow: 0 12px 40px rgba(255, 110, 196, 0.15);
    }

    .roadmap-card:hover::before {
        opacity: 1;
    }

    .roadmap-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 16px;
    }

    .roadmap-card-title {
        font-size: 1rem;
        font-weight: 600;
        color: #fff;
        margin: 0 0 4px 0;
    }

    .roadmap-card-date {
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.5);
    }

    .roadmap-card-stats {
        display: flex;
        gap: 16px;
        margin-top: 16px;
    }

    .roadmap-stat {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.7);
    }

    .roadmap-stat i {
        color: #ff6ec4;
    }

    /* Progress Ring */
    .progress-ring-container {
        position: relative;
        width: 64px;
        height: 64px;
    }

    .progress-ring {
        transform: rotate(-90deg);
    }

    .progress-ring-bg {
        fill: none;
        stroke: rgba(255, 255, 255, 0.1);
        stroke-width: 6;
    }

    .progress-ring-fill {
        fill: none;
        stroke: url(#progressGradient);
        stroke-width: 6;
        stroke-linecap: round;
        stroke-dasharray: 157;
        stroke-dashoffset: 157;
        transition: stroke-dashoffset 0.8s ease;
    }

    .progress-ring-text {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 0.9rem;
        font-weight: 700;
        color: #fff;
    }

    /* Roadmap Detail Section */
    .roadmap-detail {
        background: rgba(25, 25, 50, 0.8);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        overflow: hidden;
        display: none;
    }

    .roadmap-detail.active {
        display: block;
        animation: fadeIn 0.3s ease;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .roadmap-detail-header {
        background: rgba(30, 30, 60, 0.9);
        padding: 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        flex-wrap: wrap;
        gap: 16px;
    }

    .roadmap-detail-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #fff;
        margin: 0;
    }

    .roadmap-detail-progress {
        display: flex;
        align-items: center;
        gap: 16px;
        flex: 1;
        max-width: 400px;
    }

    .roadmap-progress-bar-container {
        flex: 1;
        height: 8px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 4px;
        overflow: hidden;
    }

    .roadmap-progress-bar {
        height: 100%;
        background: linear-gradient(135deg, #ff6ec4, #7873f5);
        border-radius: 4px;
        transition: width 0.5s ease;
    }

    .roadmap-progress-text {
        font-size: 0.9rem;
        font-weight: 600;
        color: #fff;
        min-width: 50px;
    }

    .roadmap-detail-close {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        padding: 8px 12px;
        color: rgba(255, 255, 255, 0.7);
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .roadmap-detail-close:hover {
        background: rgba(255, 255, 255, 0.12);
        color: #fff;
    }

    .roadmap-detail-body {
        padding: 24px;
    }

    /* Milestones Timeline */
    .milestones-timeline {
        position: relative;
    }

    .milestones-timeline::before {
        content: '';
        position: absolute;
        left: 28px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: linear-gradient(to bottom, #ff6ec4, #7873f5);
        opacity: 0.3;
    }

    .milestone-card {
        position: relative;
        margin-bottom: 24px;
        animation: slideIn 0.4s ease;
    }

    @@keyframes slideIn {
        from { opacity: 0; transform: translateX(-20px); }
        to { opacity: 1; transform: translateX(0); }
    }

    .milestone-card:last-child {
        margin-bottom: 0;
    }

    .milestone-marker {
        position: absolute;
        left: 16px;
        top: 20px;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: linear-gradient(135deg, #ff6ec4, #7873f5);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 700;
        color: #fff;
        z-index: 1;
        box-shadow: 0 4px 12px rgba(255, 110, 196, 0.3);
    }

    .milestone-marker.completed {
        background: #4caf50;
        box-shadow: 0 4px 12px rgba(76, 175, 80, 0.3);
    }

    .milestone-content {
        margin-left: 60px;
        background: rgba(30, 30, 60, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 12px;
        overflow: hidden;
    }

    .milestone-header {
        padding: 16px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        flex-wrap: wrap;
        gap: 12px;
    }

    .milestone-title {
        font-size: 1rem;
        font-weight: 600;
        color: #fff;
        margin: 0;
    }

    .milestone-actions {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    /* Status Badges */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .status-badge i {
        font-size: 0.65rem;
    }

    .status-completed {
        background: rgba(76, 175, 80, 0.15);
        color: #4caf50;
        border: 1px solid rgba(76, 175, 80, 0.3);
    }

    .status-in-progress {
        background: rgba(255, 193, 7, 0.15);
        color: #ffc107;
        border: 1px solid rgba(255, 193, 7, 0.3);
    }

    .status-not-started {
        background: rgba(255, 255, 255, 0.08);
        color: rgba(255, 255, 255, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.15);
    }

    /* Activities List */
    .activities-list {
        padding: 16px 20px;
    }

    .activity-item {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        padding: 16px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .activity-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .activity-item:first-child {
        padding-top: 0;
    }

    .activity-checkbox {
        width: 24px;
        height: 24px;
        border-radius: 6px;
        border: 2px solid rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .activity-checkbox:hover {
        border-color: #ff6ec4;
    }

    .activity-checkbox.completed {
        background: linear-gradient(135deg, #ff6ec4, #7873f5);
        border-color: transparent;
    }

    .activity-checkbox.completed i {
        color: #fff;
        font-size: 0.75rem;
    }

    .activity-content {
        flex: 1;
        min-width: 0;
    }

    .activity-title {
        font-size: 0.95rem;
        font-weight: 600;
        color: #fff;
        margin: 0 0 4px 0;
    }

    .activity-item.completed .activity-title {
        color: rgba(255, 255, 255, 0.5);
        text-decoration: line-through;
    }

    .activity-description {
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.6);
        margin: 0 0 8px 0;
        line-height: 1.5;
    }

    .activity-meta {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
    }

    .activity-type-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
        background: rgba(120, 115, 245, 0.15);
        border: 1px solid rgba(120, 115, 245, 0.3);
        border-radius: 6px;
        font-size: 0.7rem;
        font-weight: 600;
        color: #7873f5;
        text-transform: uppercase;
    }

    .activity-action {
        margin-left: auto;
    }

    /* Action Buttons */
    .btn-action {
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: none;
    }

    .btn-start {
        background: rgba(64, 201, 255, 0.15);
        border: 1px solid rgba(64, 201, 255, 0.3);
        color: #40c9ff;
    }

    .btn-start:hover {
        background: rgba(64, 201, 255, 0.25);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(64, 201, 255, 0.2);
        color: #40c9ff;
    }

    .btn-complete {
        background: linear-gradient(135deg, #ff6ec4, #7873f5);
        color: #fff;
    }

    .btn-complete:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(255, 110, 196, 0.3);
        color: #fff;
    }

    .btn-completed {
        background: rgba(76, 175, 80, 0.15);
        border: 1px solid rgba(76, 175, 80, 0.3);
        color: #4caf50;
        cursor: default;
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 60px 24px;
        background: rgba(25, 25, 50, 0.6);
        border: 1px dashed rgba(255, 255, 255, 0.1);
        border-radius: 16px;
    }

    .empty-state-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 24px;
        background: rgba(255, 110, 196, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .empty-state-icon i {
        font-size: 2rem;
        color: #ff6ec4;
    }

    .empty-state h3 {
        font-size: 1.25rem;
        font-weight: 600;
        color: #fff;
        margin: 0 0 12px 0;
    }

    .empty-state p {
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.6);
        margin: 0;
        max-width: 400px;
        margin: 0 auto;
        line-height: 1.6;
    }

    /* Loading Skeleton */
    .skeleton {
        background: linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.05) 25%,
            rgba(255, 255, 255, 0.1) 50%,
            rgba(255, 255, 255, 0.05) 75%
        );
        background-size: 200% 100%;
        animation: shimmer 1.5s infinite;
        border-radius: 8px;
    }

    @@keyframes shimmer {
        0% { background-position: -200% 0; }
        100% { background-position: 200% 0; }
    }

    .skeleton-card {
        padding: 20px;
        background: rgba(25, 25, 50, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 16px;
    }

    .skeleton-title {
        height: 20px;
        width: 70%;
        margin-bottom: 12px;
    }

    .skeleton-text {
        height: 14px;
        width: 50%;
        margin-bottom: 16px;
    }

    .skeleton-badge {
        height: 24px;
        width: 80px;
        border-radius: 12px;
    }

    .skeleton-milestone {
        display: flex;
        gap: 16px;
        margin-bottom: 24px;
    }

    .skeleton-marker {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .skeleton-content {
        flex: 1;
    }

    .skeleton-header {
        height: 60px;
        margin-bottom: 16px;
        border-radius: 12px;
    }

    .skeleton-activities {
        padding: 0 16px;
    }

    .skeleton-activity {
        height: 80px;
        margin-bottom: 12px;
        border-radius: 8px;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .roadmap-page {
            padding: 16px;
        }

        .roadmap-header h1 {
            font-size: 1.4rem;
        }

        .generate-section {
            padding: 16px;
        }

        .generate-form {
            flex-direction: column;
        }

        .generate-form .form-group {
            width: 100%;
        }

        .generate-form .btn {
            width: 100%;
        }

        .roadmaps-grid {
            grid-template-columns: 1fr;
        }

        .roadmap-detail-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .roadmap-detail-progress {
            width: 100%;
            max-width: none;
        }

        .milestones-timeline::before {
            left: 16px;
        }

        .milestone-content {
            margin-left: 50px;
        }

        .milestone-marker {
            left: 4px;
            width: 22px;
            height: 22px;
            font-size: 0.65rem;
        }

        .activity-item {
            flex-direction: column;
            gap: 12px;
        }

        .activity-action {
            margin-left: 0;
            width: 100%;
        }

        .activity-action .btn-action {
            width: 100%;
            justify-content: center;
        }

        .milestone-actions {
            width: 100%;
            justify-content: flex-end;
        }
    }

    @@media (max-width: 480px) {
        .roadmaps-grid {
            grid-template-columns: 1fr;
        }

        .generate-form .form-group {
            min-width: 100%;
        }
    }
</style>

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <h2>
            <i class="fas fa-map"></i>
            Learning Roadmap
        </h2>
    </div>

    <!-- Page Content -->
    <div class="page-content">
        <!-- Generate Section -->
        <div class="card-ai mb-5">
            <div class="card-ai-header">
                <h4><i class="fas fa-magic mr-2"></i>Generate New Roadmap</h4>
            </div>
            <div class="card-ai-body">
                <div class="row align-items-end">
                    <div class="col-md-6 mb-4 mb-md-0">
                        <label class="form-label-ai">Skill Gap Analysis</label>
                        <select id="skillGapAnalysisId"
                                class="form-control-ai">
                            <option value="">Loading analyses...</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <button class="btn-primary-ai" onclick="generateRoadmap()">
                            <i class="fas fa-plus mr-2"></i>
                            Generate Roadmap
                        </button>
                    </div>
                </div>
            </div>
        </div>

    <!-- Roadmaps Grid -->
    <div id="roadmapsContainer">
        <!-- Loading State -->
        <div id="roadmapsLoading" class="roadmaps-grid">
            <div class="skeleton-card">
                <div class="skeleton skeleton-title"></div>
                <div class="skeleton skeleton-text"></div>
                <div class="skeleton skeleton-badge"></div>
            </div>
            <div class="skeleton-card">
                <div class="skeleton skeleton-title"></div>
                <div class="skeleton skeleton-text"></div>
                <div class="skeleton skeleton-badge"></div>
            </div>
            <div class="skeleton-card">
                <div class="skeleton skeleton-title"></div>
                <div class="skeleton skeleton-text"></div>
                <div class="skeleton skeleton-badge"></div>
            </div>
        </div>

        <!-- Empty State -->
        <div id="roadmapsEmpty" class="empty-state" style="display: none;">
            <div class="empty-state-icon">
                <i class="fas fa-route"></i>
            </div>
            <h3>No Learning Roadmap Yet</h3>
            <p>Generate a Skill Gap Analysis first to receive a personalized roadmap.</p>
        </div>

        <!-- Roadmaps List -->
        <div id="roadmapsList" class="roadmaps-grid" style="display: none;"></div>
    </div>
</div>

<!-- Roadmap Detail -->
<div class="page-container">
    <div id="roadmapDetailPanel" class="roadmap-detail">
        <div class="roadmap-detail-header">
            <div>
                <h2 id="roadmapDetailTitle" class="roadmap-detail-title">Roadmap Title</h2>
            </div>
            <div class="roadmap-detail-progress">
                <div class="roadmap-progress-bar-container">
                    <div id="roadmapDetailProgressBar" class="roadmap-progress-bar" style="width: 0%;"></div>
                </div>
                <span id="roadmapDetailProgressText" class="roadmap-progress-text">0%</span>
            </div>
            <button class="roadmap-detail-close" onclick="closeRoadmapDetail()">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <!-- Loading Skeleton for Detail -->
        <div id="milestoneLoading" class="roadmap-detail-body" style="display: none;">
            <div class="skeleton-milestone">
                <div class="skeleton skeleton-marker"></div>
                <div class="skeleton-content">
                    <div class="skeleton skeleton-header"></div>
                    <div class="skeleton-activities">
                        <div class="skeleton skeleton-activity"></div>
                        <div class="skeleton skeleton-activity"></div>
                    </div>
                </div>
            </div>
            <div class="skeleton-milestone">
                <div class="skeleton skeleton-marker"></div>
                <div class="skeleton-content">
                    <div class="skeleton skeleton-header"></div>
                    <div class="skeleton-activities">
                        <div class="skeleton skeleton-activity"></div>
                        <div class="skeleton skeleton-activity"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Milestones -->
        <div id="milestoneContainer" class="roadmap-detail-body milestones-timeline"></div>
    </div>

    <!-- Roadmap Detail -->
    <div id="roadmapDetailPanel" class="roadmap-detail">
<svg width="0" height="0">
    <defs>
        <linearGradient id="progressGradient" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" style="stop-color:#ff6ec4"/>
            <stop offset="100%" style="stop-color:#7873f5"/>
        </linearGradient>
    </defs>
</svg>

@section Scripts {
    @* Scripts already loaded in _Layout.cshtml: api.js, auth.js, site.js *@
    <script src="~/js/guard.js"></script>
    <script src="~/js/roadmap.js?v=@DateTime.UtcNow.Ticks"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (requireLogin()) {
                loadRoadmaps();
            }
        });
    </script>
}
