@page
@model AIInterviewPlatform.Web.Pages.Roadmap.IndexModel

@{
    ViewData["Title"] = "Learning Roadmap";
}

<div class="container mt-4">

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Learning Roadmap</h4>
        </div>

        <div class="card-body">

            <div class="form-group">
                <label>Skill Gap Analysis Id</label>
                <input id="skillGapAnalysisId"
                       type="number"
                       class="form-control"
                       placeholder="Enter Skill Gap Analysis Id" />
            </div>

            <button class="btn btn-success"
                    onclick="generateRoadmap()">
                Generate Roadmap
            </button>

        </div>

    </div>

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">My Roadmaps</h5>
        </div>

        <div class="card-body">
            <div id="roadmapList">
                <div class="text-muted">Loading...</div>
            </div>
        </div>

    </div>

    <div id="roadmapDetailCard"
         class="card shadow-sm border-0"
         style="display:none;">

        <div class="card-header bg-info text-white">
            <h5 id="roadmapTitle" class="mb-0"></h5>
        </div>

        <div class="card-body">

            <h5>
                Progress:
                <span id="roadmapProgress">0%</span>
            </h5>

            <div class="progress mb-4">
                <div id="roadmapProgressBar"
                     class="progress-bar"
                     role="progressbar"
                     style="width: 0%;">
                </div>
            </div>

            <div id="milestoneContainer"></div>

        </div>

    </div>

</div>

@section Scripts {
    <script src="~/js/api.js"></script>
    <script src="~/js/site.js"></script>
    <script src="~/js/auth.js"></script>
    <script src="~/js/guard.js"></script>
    <script src="~/js/roadmap.js"></script>

    <script>
        if (requireLogin()) {
            loadRoadmaps();
        }
    </script>
}