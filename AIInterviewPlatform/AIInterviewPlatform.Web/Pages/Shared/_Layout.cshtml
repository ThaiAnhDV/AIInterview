<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <title>@ViewData["Title"] - AI Interview Platform</title>

    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700" rel="stylesheet">
    <link href="https://use.fontawesome.com/releases/v5.0.6/css/all.css" rel="stylesheet">
    <link type="text/css" href="~/assets/css/argon-design-system.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Open Sans', sans-serif;
            background: #0a0a1a;
            min-height: 100vh;
        }

        /* Video Background */
        .video-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
        }

        .video-bg video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .video-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(10, 10, 26, 0.9);
        }

        /* ========== NAVBAR ========== */
        .ai-navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 70px;
            background: rgba(15, 15, 35, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            z-index: 1000;
            display: flex;
            align-items: center;
        }

        .navbar-container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 30px;
        }

        /* Logo */
        .navbar-brand {
            display: flex;
            align-items: center;
            text-decoration: none;
            flex-shrink: 0;
            padding: 8px;
        }

        .navbar-brand img {
            height: 36px;
            width: auto;
            border-radius: 8px;
        }

        /* Navigation Menu */
        .navbar-menu {
            display: flex;
            align-items: center;
            gap: 4px;
            flex: 1;
            justify-content: center;
        }

        .nav-link {
            position: relative;
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 18px;
            color: rgba(255, 255, 255, 0.6);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 600;
            border-radius: 10px;
            transition: all 0.3s ease;
            border: 1px solid transparent;
        }

        .nav-link i {
            font-size: 0.9rem;
            width: 18px;
            text-align: center;
        }

        .nav-link:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .nav-link.active {
            color: #fff;
            background: linear-gradient(135deg, rgba(255, 110, 196, 0.2), rgba(120, 115, 245, 0.2));
            border: 1px solid rgba(255, 110, 196, 0.3);
            box-shadow: 0 0 20px rgba(255, 110, 196, 0.15);
        }

        .nav-link.active::before {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 50%;
            transform: translateX(-50%);
            width: 30px;
            height: 3px;
            background: linear-gradient(135deg, #ff6ec4, #7873f5);
            border-radius: 3px 3px 0 0;
        }

        /* User Section */
        .navbar-user {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
        }

        .user-dropdown {
            position: relative;
        }

        .user-dropdown-toggle {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 6px 14px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .user-dropdown-toggle:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 110, 196, 0.4);
        }

        .user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, #ff6ec4, #7873f5);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 700;
            font-size: 0.75rem;
        }

        .user-name {
            color: #fff;
            font-weight: 600;
            font-size: 0.85rem;
            max-width: 120px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .user-chevron {
            color: rgba(255, 255, 255, 0.5);
            font-size: 0.7rem;
            transition: transform 0.3s ease;
        }

        .user-dropdown:hover .user-chevron {
            transform: rotate(180deg);
        }

        .user-dropdown-menu {
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            min-width: 200px;
            background: rgba(20, 20, 45, 0.98);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 8px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
            opacity: 0;
            visibility: hidden;
            transform: translateY(-10px);
            transition: all 0.3s ease;
            z-index: 100;
        }

        .user-dropdown:hover .user-dropdown-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .dropdown-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            border-radius: 8px;
            transition: all 0.3s ease;
            font-size: 0.85rem;
        }

        .dropdown-item:hover {
            background: rgba(255, 255, 255, 0.08);
            color: #fff;
        }

        .dropdown-item i {
            width: 18px;
            text-align: center;
            color: #ff6ec4;
        }

        .dropdown-divider {
            height: 1px;
            background: rgba(255, 255, 255, 0.08);
            margin: 6px 0;
        }

        .dropdown-item.text-danger:hover {
            background: rgba(244, 67, 54, 0.15);
            color: #f44336;
        }

        .dropdown-item.text-danger i {
            color: #f44336;
        }

        /* Auth Buttons */
        .auth-buttons {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-auth {
            padding: 8px 16px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.85rem;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .btn-auth-login {
            background: rgba(255, 255, 255, 0.06);
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .btn-auth-login:hover {
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
            border-color: rgba(255, 255, 255, 0.25);
        }

        .btn-auth-register {
            background: linear-gradient(135deg, #ff6ec4, #7873f5);
            color: #fff;
        }

        .btn-auth-register:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(255, 110, 196, 0.35);
            color: #fff;
        }

        /* Mobile Toggle */
        .navbar-toggle {
            display: none;
            padding: 10px 12px;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            color: #fff;
            cursor: pointer;
            font-size: 1rem;
        }

        .navbar-toggle:hover {
            background: rgba(255, 255, 255, 0.1);
        }

        /* Mobile Menu */
        .mobile-menu {
            display: none;
            position: fixed;
            top: 70px;
            left: 0;
            right: 0;
            background: rgba(15, 15, 35, 0.98);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding: 16px;
            z-index: 999;
        }

        .mobile-menu.show {
            display: block;
        }

        .mobile-nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 16px;
            color: rgba(255, 255, 255, 0.7);
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 600;
            border-radius: 10px;
            transition: all 0.3s ease;
            border: 1px solid transparent;
        }

        .mobile-nav-link:hover,
        .mobile-nav-link.active {
            background: rgba(255, 255, 255, 0.06);
            color: #fff;
            border-color: rgba(255, 255, 255, 0.1);
        }

        .mobile-nav-link.active {
            background: linear-gradient(135deg, rgba(255, 110, 196, 0.15), rgba(120, 115, 245, 0.15));
            border-color: rgba(255, 110, 196, 0.25);
        }

        .mobile-nav-link i {
            width: 20px;
            text-align: center;
            color: #ff6ec4;
        }

        .mobile-auth-section {
            margin-top: 12px;
            padding-top: 12px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        /* Main Content */
        .main-content {
            position: relative;
            z-index: 1;
            padding-top: 70px;
            min-height: 100vh;
        }

        /* Card overrides */
        .card {
            background: rgba(25, 25, 50, 0.9);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
        }

        .card-header {
            background: rgba(30, 30, 60, 0.9) !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding: 18px 24px;
        }

        .card-header h4,
        .card-header h5 {
            color: #fff;
            margin: 0;
            font-size: 1rem;
        }

        .card-body {
            padding: 24px;
        }

        /* Table */
        .table {
            color: rgba(255, 255, 255, 0.85);
        }

        .table thead th {
            border-bottom: 2px solid rgba(255, 110, 196, 0.25);
            color: rgba(255, 255, 255, 0.7);
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .table td {
            border-top: 1px solid rgba(255, 255, 255, 0.06);
            vertical-align: middle;
            padding: 14px 16px;
        }

        .table-hover tbody tr:hover {
            background: rgba(255, 255, 255, 0.04);
        }

        /* Form controls */
        .form-control {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #fff;
            border-radius: 10px;
            padding: 12px 16px;
            font-size: 0.9rem;
        }

        .form-control:focus {
            background: rgba(255, 255, 255, 0.08);
            border-color: #ff6ec4;
            box-shadow: 0 0 20px rgba(255, 110, 196, 0.15);
            color: #fff;
        }

        .form-control::placeholder {
            color: rgba(255, 255, 255, 0.35);
        }

        label {
            color: rgba(255, 255, 255, 0.8);
            font-weight: 600;
            font-size: 0.85rem;
            margin-bottom: 8px;
        }

        /* Buttons */
        .btn {
            border-radius: 10px;
            padding: 10px 20px;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }

        .btn-success {
            background: linear-gradient(135deg, #ff6ec4, #7873f5);
            border: none;
            color: #fff;
        }

        .btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(255, 110, 196, 0.3);
            color: #fff;
        }

        .btn-primary {
            background: rgba(64, 201, 255, 0.15);
            border: 1px solid rgba(64, 201, 255, 0.3);
            color: #40c9ff;
        }

        .btn-primary:hover {
            background: rgba(64, 201, 255, 0.25);
            color: #fff;
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #fff;
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.12);
            color: #fff;
        }

        .btn-danger {
            background: rgba(244, 67, 54, 0.15);
            border: 1px solid rgba(244, 67, 54, 0.3);
            color: #f44336;
        }

        .btn-danger:hover {
            background: rgba(244, 67, 54, 0.25);
            color: #fff;
        }

        .btn-info {
            background: rgba(120, 115, 245, 0.15);
            border: 1px solid rgba(120, 115, 245, 0.3);
            color: #7873f5;
        }

        .btn-info:hover {
            background: rgba(120, 115, 245, 0.25);
            color: #fff;
        }

        /* Progress */
        .progress {
            background: rgba(255, 255, 255, 0.08);
            border-radius: 10px;
            height: 8px;
        }

        .progress-bar {
            background: linear-gradient(135deg, #ff6ec4, #7873f5);
            border-radius: 10px;
        }

        /* Badges */
        .badge {
            padding: 5px 12px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.75rem;
        }

        .text-primary { color: #ff6ec4 !important; }
        .text-success { color: #4caf50 !important; }
        .text-danger { color: #f44336 !important; }
        .text-muted { color: rgba(255, 255, 255, 0.5) !important; }

        .bg-primary {
            background: linear-gradient(135deg, #ff6ec4, #7873f5) !important;
        }

        /* Modal */
        .jd-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            z-index: 2000;
            align-items: center;
            justify-content: center;
        }

        .jd-modal-content {
            background: rgba(20, 20, 45, 0.98);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            width: 90%;
            max-width: 600px;
            max-height: 90vh;
            overflow: hidden;
        }

        .jd-modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 24px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            color: #fff;
        }

        .jd-modal-body {
            padding: 24px;
        }

        .jd-modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            padding: 16px 24px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        .jd-close-btn {
            background: none;
            border: none;
            color: rgba(255, 255, 255, 0.5);
            font-size: 28px;
            cursor: pointer;
            line-height: 1;
        }

        .jd-close-btn:hover {
            color: #fff;
        }

        /* Skill tags */
        .skill-tag {
            display: inline-block;
            padding: 5px 14px;
            border-radius: 20px;
            margin: 4px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .skill-matched {
            background: rgba(76, 175, 80, 0.15);
            color: #4caf50;
            border: 1px solid rgba(76, 175, 80, 0.25);
        }

        .skill-missing {
            background: rgba(244, 67, 54, 0.15);
            color: #f44336;
            border: 1px solid rgba(244, 67, 54, 0.25);
        }

        /* Footer */
        footer {
            background: rgba(10, 10, 26, 0.95);
            padding: 24px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            position: relative;
            z-index: 1;
        }

        .footer-content {
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        .footer-copyright {
            color: rgba(255, 255, 255, 0.45);
            font-size: 0.85rem;
        }

        .footer-links {
            display: flex;
            gap: 20px;
        }

        .footer-links a {
            color: rgba(255, 255, 255, 0.45);
            text-decoration: none;
            font-size: 0.85rem;
            transition: color 0.3s ease;
        }

        .footer-links a:hover {
            color: #ff6ec4;
        }

        /* Responsive */
        @@media (max-width: 1024px) {
            .navbar-menu {
                display: none;
            }
            .navbar-user {
                display: none;
            }
            .navbar-toggle {
                display: block;
            }
            .footer-content {
                flex-direction: column;
                text-align: center;
            }
        }
    </style>
</head>

<body>
    <!-- Video Background -->
    <div class="video-bg">
        <video autoplay muted loop playsinline>
            <source src="~/videos/videoBackGoundHome.mp4" type="video/mp4">
        </video>
        <div class="video-overlay"></div>
    </div>

    <!-- Navbar -->
    <nav class="ai-navbar">
        <div class="navbar-container">
            <!-- Logo -->
            <a class="navbar-brand" href="/">
                <img src="~/img/logo.png" alt="AI Interview">
            </a>

            <!-- Navigation Menu -->
            <div class="navbar-menu">
                <a href="/" class="nav-link" id="nav-dashboard">
                    <i class="fas fa-home"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/Resume" class="nav-link" id="nav-resume">
                    <i class="fas fa-file-alt"></i>
                    <span>Resume</span>
                </a>
                <a href="/TargetJob" class="nav-link" id="nav-targetjob">
                    <i class="fas fa-bullseye"></i>
                    <span>Target Jobs</span>
                </a>
                <a href="/Interview" class="nav-link" id="nav-interview">
                    <i class="fas fa-comments"></i>
                    <span>Interview</span>
                </a>
                <a href="/Roadmap" class="nav-link" id="nav-roadmap">
                    <i class="fas fa-map"></i>
                    <span>Roadmap</span>
                </a>
            </div>

            <!-- User Section -->
            <div class="navbar-user">
                <div class="user-dropdown" id="userDropdown" style="display: none;">
                    <a href="#" class="user-dropdown-toggle">
                        <div class="user-avatar" id="userAvatar">U</div>
                        <span class="user-name" id="userName">User</span>
                        <i class="fas fa-chevron-down user-chevron"></i>
                    </a>
                    <div class="user-dropdown-menu">
                        <a href="/Profile" class="dropdown-item">
                            <i class="fas fa-user"></i> Profile
                        </a>
                        <a href="/Resume" class="dropdown-item">
                            <i class="fas fa-file-alt"></i> My Resume
                        </a>
                        <div class="dropdown-divider"></div>
                        <a href="#" onclick="logout(); return false;" class="dropdown-item text-danger">
                            <i class="fas fa-sign-out-alt"></i> Logout
                        </a>
                    </div>
                </div>

                <div class="auth-buttons" id="authButtons">
                    <a href="/Auth/Login" class="btn-auth btn-auth-login">Login</a>
                    <a href="/Auth/Register" class="btn-auth btn-auth-register">Register</a>
                </div>
            </div>

            <!-- Mobile Toggle (always visible) -->
            <button class="navbar-toggle" onclick="toggleMobileMenu()">
                <i class="fas fa-bars"></i>
            </button>
        </div>
    </nav>

    <!-- Mobile Menu -->
    <div class="mobile-menu" id="mobileMenu">
        <a href="/" class="mobile-nav-link" id="mobile-nav-dashboard">
            <i class="fas fa-home"></i> Dashboard
        </a>
        <a href="/Resume" class="mobile-nav-link" id="mobile-nav-resume">
            <i class="fas fa-file-alt"></i> Resume
        </a>
        <a href="/TargetJob" class="mobile-nav-link" id="mobile-nav-targetjob">
            <i class="fas fa-bullseye"></i> Target Jobs
        </a>
        <a href="/Interview" class="mobile-nav-link" id="mobile-nav-interview">
            <i class="fas fa-comments"></i> Interview
        </a>
        <a href="/Roadmap" class="mobile-nav-link" id="mobile-nav-roadmap">
            <i class="fas fa-map"></i> Roadmap
        </a>
        
        <div class="mobile-auth-section" id="mobileAuthSection">
            <a href="/Auth/Login" class="mobile-nav-link">
                <i class="fas fa-sign-in-alt"></i> Login
            </a>
            <a href="/Auth/Register" class="mobile-nav-link">
                <i class="fas fa-user-plus"></i> Register
            </a>
            <a href="#" onclick="logout(); return false;" class="mobile-nav-link" style="display: none;" id="mobileLogoutBtn">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer>
        <div class="footer-content">
            <div class="footer-copyright">
                &copy; 2026 AI Interview Platform
            </div>
            <div class="footer-links">
                <a href="/">Dashboard</a>
                <a href="/Profile">Profile</a>
                <a href="/Resume">Resume</a>
                <a href="/Interview">Interview</a>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/assets/js/core/jquery.min.js"></script>
    <script src="~/assets/js/core/popper.min.js"></script>
    <script src="~/assets/js/core/bootstrap.min.js"></script>
    <script src="~/assets/js/argon-design-system.min.js"></script>
    <script src="~/js/api.js"></script>
    <script src="~/js/auth.js"></script>
    <script src="~/js/site.js"></script>

    <script>
        // Initialize AuthManager first
        (async function initializeAuth() {
            // Wait for auth to be validated with backend
            await AuthManager.init();
            
            // Now update UI based on validated auth state
            updateNavbarUI();
        })();

        // Update navbar UI based on validated auth state
        function updateNavbarUI() {
            const state = AuthManager.getState();
            
            const userDropdown = document.getElementById('userDropdown');
            const authButtons = document.getElementById('authButtons');
            const userName = document.getElementById('userName');
            const userAvatar = document.getElementById('userAvatar');
            const mobileAuthSection = document.getElementById('mobileAuthSection');
            const mobileLogoutBtn = document.getElementById('mobileLogoutBtn');

            if (state.isAuthenticated && state.user) {
                userDropdown.style.display = 'block';
                authButtons.style.display = 'none';
                
                const userData = state.user;
                const displayName = userData.fullName || userData.email || 'User';
                userName.textContent = displayName;
                
                const initials = displayName.split(' ')
                    .map(n => n[0])
                    .join('')
                    .substring(0, 2)
                    .toUpperCase();
                userAvatar.textContent = initials;
                
                // Mobile auth
                if (mobileAuthSection) {
                    mobileAuthSection.querySelectorAll('a[href="/Auth/Login"], a[href="/Auth/Register"]').forEach(function(a) {
                        a.style.display = 'none';
                    });
                }
                if (mobileLogoutBtn) mobileLogoutBtn.style.display = 'flex';
            } else {
                userDropdown.style.display = 'none';
                authButtons.style.display = 'flex';
                
                // Mobile auth
                if (mobileAuthSection) {
                    mobileAuthSection.querySelectorAll('a[href="/Auth/Login"], a[href="/Auth/Register"]').forEach(function(a) {
                        a.style.display = 'flex';
                    });
                }
                if (mobileLogoutBtn) mobileLogoutBtn.style.display = 'none';
            }
        }

        // Subscribe to auth state changes
        AuthManager.onAuthChange(function(state) {
            updateNavbarUI();
        });

        // Set active nav item
        document.addEventListener('DOMContentLoaded', function() {
            const path = window.location.pathname;
            
            // Desktop nav
            document.querySelectorAll('.nav-link').forEach(function(link) {
                link.classList.remove('active');
            });
            
            // Mobile nav
            document.querySelectorAll('.mobile-nav-link').forEach(function(link) {
                link.classList.remove('active');
            });
            
            if (path === '/' || path === '') {
                document.getElementById('nav-dashboard')?.classList.add('active');
                document.getElementById('mobile-nav-dashboard')?.classList.add('active');
            } else if (path.startsWith('/Resume')) {
                document.getElementById('nav-resume')?.classList.add('active');
                document.getElementById('mobile-nav-resume')?.classList.add('active');
            } else if (path.startsWith('/TargetJob')) {
                document.getElementById('nav-targetjob')?.classList.add('active');
                document.getElementById('mobile-nav-targetjob')?.classList.add('active');
            } else if (path.startsWith('/Interview')) {
                document.getElementById('nav-interview')?.classList.add('active');
                document.getElementById('mobile-nav-interview')?.classList.add('active');
            } else if (path.startsWith('/Roadmap')) {
                document.getElementById('nav-roadmap')?.classList.add('active');
                document.getElementById('mobile-nav-roadmap')?.classList.add('active');
            }
        });

        // Mobile menu toggle
        function toggleMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            menu.classList.toggle('show');
        }

        // Close mobile menu on link click
        document.querySelectorAll('.mobile-nav-link').forEach(function(link) {
            link.addEventListener('click', function() {
                document.getElementById('mobileMenu').classList.remove('show');
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
