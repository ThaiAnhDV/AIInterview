@page
@model AIInterviewPlatform.Web.Pages.TargetJob.JobDescriptionModel

@{
    ViewData["Title"] = "Job Description";
}

<div class="container mt-4">

    <div class="card shadow-sm border-0">

        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Target Job Description</h4>
        </div>

        <div class="card-body">

            <input type="hidden"
                   id="targetJobId"
                   value="@Request.Query["targetJobId"]" />

            <p class="text-muted">
                Enter the job description for this target job.
            </p>

            <textarea id="jobDescriptionContent"
                      class="form-control"
                      rows="14"
                      placeholder="Example: Required skills: C#, ASP.NET Core, SQL Server, REST API, JWT, Git..."></textarea>

            <div class="mt-4">
                <button class="btn btn-success"
                        onclick="saveJobDescription()">
                    Save Job Description
                </button>

                <a href="/TargetJob"
                   class="btn btn-secondary">
                    Back
                </a>
            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script src="~/js/api.js"></script>
    <script src="~/js/site.js"></script>
    <script src="~/js/auth.js"></script>
    <script src="~/js/guard.js"></script>
    <script src="~/js/job-description.js"></script>

    <script>
        if (requireLogin()) {
            loadJobDescription();
        }
    </script>
}