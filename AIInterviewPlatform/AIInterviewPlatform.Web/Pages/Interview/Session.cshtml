@page
@model AIInterviewPlatform.Web.Pages.Interview.SessionModel

@{
    ViewData["Title"] = "Interview Session";
}

<div class="container mt-4">

    <div class="card shadow border-0">

        <div class="card-header bg-success text-white">

            <h4 id="jobTitle">
                Interview Session
            </h4>

        </div>

        <div class="card-body">

            <div id="questionContainer"></div>

            <hr />

            <div class="text-center mt-4">

                <button class="btn-primary-ai"
                        onclick="submitInterviewAnswers()">

                    Submit Answers

                </button>

            </div>

            <hr />

            <div id="evaluationResult"
                 style="display:none;">

                <div class="card border-success">

                    <div class="card-header bg-success text-white">

                        <h5>
                            Interview Result
                        </h5>

                    </div>

                    <div class="card-body">

                        <h4>
                            Overall Score:
                            <span id="overallScore"></span>
                        </h4>

                        <hr />

                        <h5>
                            Feedback
                        </h5>

                        <ul id="feedbackList"></ul>

                    </div>

                </div>

            </div>

            <hr />

            <button class="btn-danger-ai"
                    onclick="completeInterview()">

                Complete Interview

            </button>

            <a id="feedbackLink"
               class="btn-secondary-ai"
               href="#">
                View Feedback
            </a>

        </div>

    </div>

</div>

@section Scripts {
    @* Core scripts already loaded in _Layout.cshtml: api.js, auth.js, site.js *@
    <script src="~/js/interview.js"></script>

    <script>

        loadInterviewSession();

    </script>

}