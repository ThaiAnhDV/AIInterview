@page
@model AIInterviewPlatform.Web.Pages.Interview.IndexModel

@{
    ViewData["Title"] = "Mock Interview";
}

<div class="container mt-4">

    <div class="card shadow border-0">

        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">
                Mock Interview
            </h4>
        </div>

        <div class="card-body">

            <div class="form-group">

                <label>
                    Select Target Job
                </label>

                <select id="targetJobSelect"
                        class="form-control">
                </select>

            </div>

            <button class="btn btn-success"
                    onclick="startInterview()">

                Start Interview

            </button>

        </div>

    </div>

</div>

@section Scripts {
    @* Core scripts already loaded in _Layout.cshtml: api.js, auth.js, site.js *@
    <script src="~/js/interview.js"></script>

    <script>

        loadTargetJobsForInterview();

    </script>

}