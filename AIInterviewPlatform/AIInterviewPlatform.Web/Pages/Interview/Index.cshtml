@page
@model AIInterviewPlatform.Web.Pages.Interview.IndexModel

@{
    ViewData["Title"] = "Mock Interview";
}

<style>
    /* Interview Page Specific Styles */
    
    /* Selection Card */
    .interview-selection-card {
        background: linear-gradient(135deg, rgba(255, 110, 196, 0.08), rgba(120, 115, 245, 0.08));
        border: 1px solid var(--ai-border);
        border-radius: var(--ai-radius-2xl);
        padding: var(--ai-space-8);
        margin-bottom: var(--ai-space-6);
    }

    .interview-selection-header {
        text-align: center;
        margin-bottom: var(--ai-space-6);
    }

    .interview-selection-header h3 {
        color: var(--ai-text-primary);
        margin-bottom: var(--ai-space-2);
    }

    .interview-selection-header p {
        color: var(--ai-text-muted);
        max-width: 500px;
        margin: 0 auto;
    }

    .interview-form-row {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--ai-space-6);
        margin-bottom: var(--ai-space-6);
    }

    .empty-state-inline {
        background: var(--ai-warning-bg);
        border: 1px solid var(--ai-warning-border);
        border-radius: var(--ai-radius-lg);
        padding: var(--ai-space-4);
        margin-top: var(--ai-space-3);
        color: var(--ai-warning);
        font-size: var(--ai-font-size-sm);
        display: flex;
        align-items: center;
        gap: var(--ai-space-2);
    }

    /* Stats Grid */
    .interview-stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--ai-space-4);
        margin-bottom: var(--ai-space-6);
    }

    .interview-stat-card {
        background: var(--ai-card-bg);
        border: 1px solid var(--ai-border);
        border-radius: var(--ai-radius-xl);
        padding: var(--ai-space-5);
        text-align: center;
        transition: all var(--ai-transition-normal);
    }

    .interview-stat-card:hover {
        transform: translateY(-2px);
        border-color: var(--ai-border-primary);
        box-shadow: var(--ai-shadow-md);
    }

    .interview-stat-icon {
        width: 48px;
        height: 48px;
        margin: 0 auto var(--ai-space-3);
        border-radius: var(--ai-radius-lg);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: var(--ai-font-size-xl);
    }

    .interview-stat-icon.pink { background: rgba(255, 110, 196, 0.15); color: var(--ai-pink); }
    .interview-stat-icon.blue { background: var(--ai-info-bg); color: var(--ai-info); }
    .interview-stat-icon.warning { background: var(--ai-warning-bg); color: var(--ai-warning); }
    .interview-stat-icon.green { background: var(--ai-success-bg); color: var(--ai-success); }

    .interview-stat-value {
        font-size: var(--ai-font-size-3xl);
        font-weight: var(--ai-font-weight-bold);
        color: var(--ai-text-primary);
        margin-bottom: var(--ai-space-1);
    }

    .interview-stat-label {
        color: var(--ai-text-muted);
        font-size: var(--ai-font-size-sm);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Category Section */
    .category-section {
        margin-bottom: var(--ai-space-8);
    }

    .category-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: var(--ai-space-5);
        padding-bottom: var(--ai-space-4);
        border-bottom: 1px solid var(--ai-border);
    }

    .category-title {
        display: flex;
        align-items: center;
        gap: var(--ai-space-3);
        margin: 0;
    }

    .category-title i {
        font-size: var(--ai-font-size-xl);
    }

    /* Question Cards */
    .question-cards-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--ai-space-5);
    }

    .question-card-ai {
        background: var(--ai-card-bg);
        border: 1px solid var(--ai-border);
        border-radius: var(--ai-radius-xl);
        overflow: hidden;
        transition: all var(--ai-transition-normal);
    }

    .question-card-ai:hover {
        transform: translateY(-4px);
        box-shadow: var(--ai-shadow-lg);
        border-color: var(--ai-border-primary);
    }

    .question-card-header {
        padding: var(--ai-space-4) var(--ai-space-5);
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--ai-border);
    }

    .question-card-header.technical {
        background: rgba(64, 201, 255, 0.08);
        border-bottom-color: rgba(64, 201, 255, 0.2);
    }

    .question-card-header.behavioral {
        background: rgba(255, 193, 7, 0.08);
        border-bottom-color: rgba(255, 193, 7, 0.2);
    }

    .question-card-header.communication {
        background: rgba(76, 175, 80, 0.08);
        border-bottom-color: rgba(76, 175, 80, 0.2);
    }

    .question-badge {
        display: inline-flex;
        align-items: center;
        gap: var(--ai-space-2);
        padding: var(--ai-space-1) var(--ai-space-3);
        border-radius: var(--ai-radius-full);
        font-size: var(--ai-font-size-xs);
        font-weight: var(--ai-font-weight-medium);
    }

    .question-badge.technical {
        background: rgba(64, 201, 255, 0.2);
        color: var(--ai-info);
    }

    .question-badge.behavioral {
        background: rgba(255, 193, 7, 0.2);
        color: var(--ai-warning);
    }

    .question-badge.communication {
        background: rgba(76, 175, 80, 0.2);
        color: var(--ai-success);
    }

    .question-number {
        color: var(--ai-text-muted);
        font-size: var(--ai-font-size-sm);
    }

    .question-card-body {
        padding: var(--ai-space-5);
    }

    .question-content {
        color: var(--ai-text-primary);
        font-size: var(--ai-font-size-md);
        line-height: var(--ai-line-height-relaxed);
        margin-bottom: var(--ai-space-4);
    }

    .question-meta {
        display: flex;
        flex-wrap: wrap;
        gap: var(--ai-space-3);
    }

    /* Answer Cards */
    .interview-chat-shell {
        max-width: 920px;
        margin: 0 auto;
        background: rgba(20, 20, 45, 0.96);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 24px 70px rgba(0, 0, 0, 0.35);
    }

    .interview-chat-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--ai-space-4);
        padding: 18px 22px;
        background: rgba(30, 30, 60, 0.85);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .interview-chat-person {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .interview-chat-avatar,
    .message-avatar-ai,
    .message-avatar-user {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .interview-chat-avatar,
    .message-avatar-ai {
        background: linear-gradient(135deg, #ff6ec4, #7873f5);
    }

    .message-avatar-user {
        background: rgba(64, 201, 255, 0.2);
        color: #40c9ff;
    }

    .interview-chat-title {
        color: #fff;
        font-weight: 700;
        margin: 0 0 2px;
    }

    .interview-chat-status {
        display: flex;
        align-items: center;
        gap: 5px;
        color: #4caf50;
        font-size: 0.8rem;
        margin: 0;
    }

    .interview-chat-time {
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.85rem;
        white-space: nowrap;
    }

    .interview-chat-body {
        padding: 24px 22px 30px;
    }

    .interview-chat-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        padding: 0 0 20px;
        color: rgba(255, 255, 255, 0.65);
    }

    .interview-chat-messages {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .chat-question-pair {
        display: grid;
        gap: 16px;
    }

    .chat-message-row {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .chat-message-row.user {
        justify-content: flex-end;
    }

    .chat-message-row.user .message-avatar-user {
        order: 2;
    }

    .message-bubble-ai,
    .message-bubble-user {
        max-width: min(680px, 78%);
        border-radius: 12px;
        padding: 14px 16px;
        line-height: 1.55;
        color: #fff;
    }

    .message-bubble-ai {
        background: rgba(255, 255, 255, 0.055);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .message-bubble-user {
        background: rgba(64, 201, 255, 0.18);
        border: 1px solid rgba(64, 201, 255, 0.4);
    }

    .message-bubble-label {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 8px;
        color: rgba(255, 255, 255, 0.64);
        font-size: 0.78rem;
        font-weight: 700;
    }

    .chat-answer-input {
        width: 100%;
        min-height: 104px;
        padding: 0;
        background: transparent;
        border: 0;
        color: #fff;
        resize: vertical;
        outline: none;
        line-height: 1.55;
    }

    .chat-answer-input::placeholder {
        color: rgba(255, 255, 255, 0.48);
    }

    .chat-answer-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-top: 10px;
        color: rgba(255, 255, 255, 0.55);
        font-size: 0.78rem;
    }

    .chat-submit-bar {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: var(--ai-space-3);
        padding: 22px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(15, 15, 35, 0.7);
    }

    .chat-feedback-panel {
        max-width: 920px;
        margin: 0 auto;
        background: rgba(24, 34, 49, 0.94);
        border: 1px solid rgba(76, 175, 80, 0.28);
        border-radius: 0 0 14px 14px;
        padding: 24px;
        text-align: left;
    }

    .chat-feedback-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 20px;
        color: #fff;
        font-weight: 700;
    }

    .feedback-score-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        border-radius: 8px;
        background: rgba(76, 175, 80, 0.18);
        color: #4caf50;
        font-weight: 800;
    }

    .chat-feedback-list {
        display: grid;
        gap: 12px;
        margin: 0 0 22px;
        padding: 0;
        list-style: none;
        color: rgba(255, 255, 255, 0.78);
    }

    .chat-feedback-list i {
        color: #4caf50;
        margin-right: 8px;
    }

    .answer-card-ai {
        background: var(--ai-card-bg);
        border: 1px solid var(--ai-border);
        border-radius: var(--ai-radius-xl);
        overflow: hidden;
        margin-bottom: var(--ai-space-5);
    }

    .answer-card-ai:last-child {
        margin-bottom: 0;
    }

    .answer-card-header {
        padding: var(--ai-space-4) var(--ai-space-5);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--ai-space-3);
    }

    .answer-card-header.technical {
        background: rgba(64, 201, 255, 0.08);
        border-bottom: 1px solid rgba(64, 201, 255, 0.2);
    }

    .answer-card-header.behavioral {
        background: rgba(255, 193, 7, 0.08);
        border-bottom: 1px solid rgba(255, 193, 7, 0.2);
    }

    .answer-card-header.communication {
        background: rgba(76, 175, 80, 0.08);
        border-bottom: 1px solid rgba(76, 175, 80, 0.2);
    }

    .answer-status-indicator {
        display: flex;
        align-items: center;
        gap: var(--ai-space-2);
        font-size: var(--ai-font-size-sm);
    }

    .answer-status-indicator.answered {
        color: var(--ai-success);
    }

    .answer-status-indicator.pending {
        color: var(--ai-text-muted);
    }

    .answer-card-body {
        padding: var(--ai-space-5);
    }

    .answer-question-text {
        color: var(--ai-text-secondary);
        font-size: var(--ai-font-size-sm);
        margin-bottom: var(--ai-space-4);
        padding: var(--ai-space-3);
        background: rgba(255, 255, 255, 0.02);
        border-radius: var(--ai-radius-md);
        border-left: 3px solid var(--ai-pink);
    }

    .answer-textarea-wrapper {
        position: relative;
    }

    .answer-textarea-ai {
        width: 100%;
        min-height: 140px;
        padding: var(--ai-space-4);
        background: var(--ai-input-bg);
        border: 1px solid var(--ai-border);
        border-radius: var(--ai-radius-lg);
        color: var(--ai-text-primary);
        font-size: var(--ai-font-size-md);
        line-height: var(--ai-line-height-relaxed);
        resize: vertical;
        transition: all var(--ai-transition-fast);
    }

    .answer-textarea-ai:focus {
        outline: none;
        border-color: var(--ai-pink);
        box-shadow: 0 0 0 3px rgba(255, 110, 196, 0.15);
        background: var(--ai-input-bg-focus);
    }

    .answer-textarea-ai::placeholder {
        color: var(--ai-text-disabled);
    }

    .answer-char-counter {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: var(--ai-space-2);
        font-size: var(--ai-font-size-sm);
    }

    .char-count-text {
        color: var(--ai-text-muted);
    }

    .char-validation {
        display: flex;
        align-items: center;
        gap: var(--ai-space-1);
    }

    .char-validation.valid {
        color: var(--ai-success);
    }

    .char-validation.invalid {
        color: var(--ai-text-muted);
    }

    /* Evaluation Result */
    .evaluation-card {
        background: var(--ai-card-bg);
        border: 1px solid var(--ai-border);
        border-radius: var(--ai-radius-xl);
        overflow: hidden;
        margin-bottom: var(--ai-space-5);
    }

    .evaluation-header {
        background: linear-gradient(135deg, rgba(255, 110, 196, 0.1), rgba(120, 115, 245, 0.1));
        padding: var(--ai-space-5);
        border-bottom: 1px solid var(--ai-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .evaluation-score-circle {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: var(--ai-font-size-2xl);
        font-weight: var(--ai-font-weight-bold);
    }

    .evaluation-score-circle.excellent {
        background: var(--ai-success-bg);
        color: var(--ai-success);
        border: 3px solid var(--ai-success);
    }

    .evaluation-score-circle.good {
        background: var(--ai-info-bg);
        color: var(--ai-info);
        border: 3px solid var(--ai-info);
    }

    .evaluation-score-circle.fair {
        background: var(--ai-warning-bg);
        color: var(--ai-warning);
        border: 3px solid var(--ai-warning);
    }

    .evaluation-score-circle.poor {
        background: var(--ai-danger-bg);
        color: var(--ai-danger);
        border: 3px solid var(--ai-danger);
    }

    /* Progress Badge */
    .progress-badge {
        background: var(--ai-primary-gradient);
        padding: var(--ai-space-2) var(--ai-space-4);
        border-radius: var(--ai-radius-full);
        font-size: var(--ai-font-size-sm);
        font-weight: var(--ai-font-weight-medium);
        color: var(--ai-text-primary);
    }

    /* Action Buttons */
    .interview-actions {
        display: flex;
        gap: var(--ai-space-4);
        justify-content: center;
        flex-wrap: wrap;
    }

    /* Responsive */
    @@media (max-width: 1024px) {
        .question-cards-grid {
            grid-template-columns: 1fr;
        }

        .interview-stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .interview-form-row {
            grid-template-columns: 1fr;
            gap: var(--ai-space-4);
        }

        .interview-stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .interview-stat-card {
            padding: var(--ai-space-4);
        }

        .interview-stat-icon {
            width: 40px;
            height: 40px;
        }

        .interview-stat-value {
            font-size: var(--ai-font-size-2xl);
        }

        .category-header {
            flex-direction: column;
            align-items: flex-start;
            gap: var(--ai-space-3);
        }

        .question-card-header,
        .answer-card-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .message-bubble-ai,
        .message-bubble-user {
            max-width: 88%;
        }

        .interview-actions {
            flex-direction: column;
        }

        .interview-actions .btn {
            width: 100%;
        }
    }

    @@media (max-width: 480px) {
        .interview-stats-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <h2>
            <i class="fas fa-comments"></i>
            Mock Interview
        </h2>
    </div>

    <!-- Page Content -->
    <div class="page-content">
        <!-- Selection Card -->
        <div class="card-ai" id="selectionCard">
            <div class="card-ai-header">
                <h4><i class="fas fa-cog mr-2"></i>Configure Interview</h4>
            </div>
            <div class="card-ai-body">
                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label class="form-label-ai">Target Job</label>
                        <select id="targetJobSelect" class="form-select-ai">
                            <option value="">-- Select Target Job --</option>
                        </select>
                        <div id="noTargetJobsMessage" class="empty-state-inline" style="display: none;">
                            <i class="fas fa-info-circle"></i>
                            Create a Target Job first.
                            <a href="/TargetJob" class="text-ai-primary ml-2">Go to Target Jobs →</a>
                        </div>
                    </div>
                    <div class="col-md-6 mb-4">
                        <label class="form-label-ai">Skill Gap Analysis</label>
                        <select id="skillGapSelect" class="form-select-ai">
                            <option value="">-- Select Analysis --</option>
                        </select>
                        <div id="noAnalysesMessage" class="empty-state-inline" style="display: none;">
                            <i class="fas fa-info-circle"></i>
                            Run Skill Gap Analysis first.
                            <a href="/SkillGap" class="text-ai-primary ml-2">Go to Analysis →</a>
                        </div>
                    </div>
                </div>
                <div class="mt-4 text-center">
                    <button id="startInterviewButton" class="btn-primary-ai btn-lg" onclick="startMockInterview()">
                        <i class="fas fa-play mr-2"></i>
                        Start Mock Interview
                    </button>
                </div>
            </div>
        </div>

        <!-- Loading State -->
        <div id="loadingState" class="card-ai" style="display: none;">
            <div class="card-ai-body text-center py-5">
                <div class="loading-spinner-ai loading-spinner-ai-lg mx-auto mb-4"></div>
                <h5 class="text-ai-primary mb-2">Generating Interview Questions...</h5>
                <p class="text-ai-muted">Our AI is crafting personalized questions based on your profile.</p>
            </div>
        </div>

        <!-- Results Container -->
        <div id="resultsContainer" style="display: none;">
            <!-- Summary Card -->
            <div class="card-ai mb-6">
                <div class="card-ai-header">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <h4><i class="fas fa-clipboard-check mr-2"></i>Interview Summary</h4>
                        <div class="d-flex align-items-center gap-3">
                            <span id="fallbackBadge" class="badge-ai badge-ai-warning" style="display: none;">
                                <i class="fas fa-exclamation-triangle mr-1"></i>
                                Fallback Questions
                            </span>
                            <span id="sessionBadge" class="badge-ai badge-ai-info">Session #0</span>
                        </div>
                    </div>
                </div>
                <div class="card-ai-body">
                    <!-- Stats Grid -->
                    <div class="interview-stats-grid">
                        <div class="interview-stat-card">
                            <div class="interview-stat-icon pink">
                                <i class="fas fa-question-circle"></i>
                            </div>
                            <div class="interview-stat-value" id="statTotal">0</div>
                            <div class="interview-stat-label">Total</div>
                        </div>
                        <div class="interview-stat-card">
                            <div class="interview-stat-icon blue">
                                <i class="fas fa-laptop-code"></i>
                            </div>
                            <div class="interview-stat-value" id="statTechnical">0</div>
                            <div class="interview-stat-label">Technical</div>
                        </div>
                        <div class="interview-stat-card">
                            <div class="interview-stat-icon warning">
                                <i class="fas fa-users"></i>
                            </div>
                            <div class="interview-stat-value" id="statBehavioral">0</div>
                            <div class="interview-stat-label">Behavioral</div>
                        </div>
                        <div class="interview-stat-card">
                            <div class="interview-stat-icon green">
                                <i class="fas fa-comments"></i>
                            </div>
                            <div class="interview-stat-value" id="statCommunication">0</div>
                            <div class="interview-stat-label">Communication</div>
                        </div>
                    </div>

                    <!-- Job Info -->
                    <div class="row mb-4">
                        <div class="col-md-6 mb-3">
                            <div class="text-ai-muted small mb-1">Job Position</div>
                            <div id="summaryJobTitle" class="text-ai-primary font-weight-bold">-</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="text-ai-muted small mb-1">Session ID</div>
                            <div id="summarySessionId" class="text-ai-primary font-weight-bold">-</div>
                        </div>
                    </div>

                    <div class="interview-actions mt-5">
                        <button class="btn-primary-ai btn-lg" onclick="showAnswerForm()">
                            <i class="fas fa-edit mr-2"></i>
                            Answer Questions
                        </button>
                        <button class="btn-secondary-ai btn-lg" onclick="resetToSelection()">
                            <i class="fas fa-plus mr-2"></i>
                            New Interview
                        </button>
                    </div>
                </div>
            </div>

            <!-- Technical Questions -->
            <div id="technicalSection" class="category-section" style="display: none;">
                <div class="category-header">
                    <h4 class="category-title text-ai-info">
                        <i class="fas fa-laptop-code"></i>
                        Technical Questions
                    </h4>
                    <span id="technicalCount" class="badge-ai badge-ai-info">0</span>
                </div>
                <div id="technicalCards" class="question-cards-grid"></div>
            </div>

            <!-- Behavioral Questions -->
            <div id="behavioralSection" class="category-section" style="display: none;">
                <div class="category-header">
                    <h4 class="category-title text-ai-warning">
                        <i class="fas fa-users"></i>
                        Behavioral Questions
                    </h4>
                    <span id="behavioralCount" class="badge-ai badge-ai-warning">0</span>
                </div>
                <div id="behavioralCards" class="question-cards-grid"></div>
            </div>

            <!-- Communication Questions -->
            <div id="communicationSection" class="category-section" style="display: none;">
                <div class="category-header">
                    <h4 class="category-title text-ai-success">
                        <i class="fas fa-comments"></i>
                        Communication Questions
                    </h4>
                    <span id="communicationCount" class="badge-ai badge-ai-success">0</span>
                </div>
                <div id="communicationCards" class="question-cards-grid"></div>
            </div>
        </div>

        <!-- Answer Form Section -->
        <div id="answerFormSection" style="display: none;">
            <div class="interview-chat-shell">
                <div class="interview-chat-header">
                    <div class="interview-chat-person">
                        <div class="interview-chat-avatar"></div>
                        <div>
                            <p class="interview-chat-title">Người phỏng vấn AI</p>
                            <p class="interview-chat-status">
                                <i class="fas fa-circle"></i>
                                Đang trực tuyến
                            </p>
                        </div>
                    </div>
                    <div class="interview-chat-time">
                        <i class="fas fa-clock"></i>
                        <span id="interviewClock">12:34</span>
                    </div>
                </div>
                <div class="interview-chat-body">
                    <div class="interview-chat-meta">
                        <span id="chatSessionMeta">Phiên phỏng vấn</span>
                        <span id="answerProgress" class="progress-badge">0/0 Answered</span>
                    </div>
                    <div id="answerQuestionsContainer" class="interview-chat-messages"></div>

                    <!-- Validation Messages -->
                    <div id="validationMessage" class="alert-ai alert-ai-warning mt-5" style="display: none;">
                        <i class="fas fa-exclamation-triangle mr-2"></i>
                        <span id="validationText"></span>
                    </div>
                </div>
                <div class="chat-submit-bar">
                    <button id="submitAnswersButton" class="btn-primary-ai btn-lg" onclick="submitAllAnswers()">
                        <i class="fas fa-paper-plane mr-2"></i>
                        Submit All Answers
                    </button>
                    <button class="btn-secondary-ai btn-lg" onclick="resetToSelection()">
                        <i class="fas fa-plus mr-2"></i>
                        Start New Interview
                    </button>
                </div>
            </div>
        </div>

        <!-- Error State -->
        <div id="errorState" class="error-state" style="display: none;">
            <div class="error-state-icon">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <h4 class="error-state-title">Something went wrong</h4>
            <p id="errorMessage" class="error-state-description">-</p>
            <button class="btn-secondary-ai" onclick="resetToSelection()">
                <i class="fas fa-redo mr-2"></i>
                Try Again
            </button>
        </div>

        <!-- Success State -->
        <div id="successState" style="display: none;">
            <div class="chat-feedback-panel">
                <div class="chat-feedback-header">
                    <span>
                        <i class="fas fa-chart-bar text-ai-success mr-2"></i>
                        Nhận xét phỏng vấn
                    </span>
                    <span class="feedback-score-pill">
                        <i class="fas fa-star"></i>
                        Đã gửi
                    </span>
                </div>
                <ul class="chat-feedback-list">
                    <li><i class="fas fa-check-circle"></i>Câu trả lời của bạn đã được ghi nhận</li>
                    <li><i class="fas fa-check-circle"></i>Hệ thống sẽ đánh giá nội dung và kỹ năng liên quan</li>
                    <li><i class="fas fa-check-circle"></i>Xem feedback để biết điểm mạnh và phần cần cải thiện</li>
                </ul>
                <div class="interview-actions">
                    <a id="viewFeedbackBtn" href="#" class="btn-primary-ai btn-lg">
                        <i class="fas fa-star mr-2"></i>
                        View Feedback
                    </a>
                    <button class="btn-secondary-ai btn-lg" onclick="resetToSelection()">
                        <i class="fas fa-plus mr-2"></i>
                        Start New Interview
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
    <script src="~/js/interview.js"></script>
    <script>
        // ============================================
        // Page State
        // ============================================
        const InterviewPageState = {
            currentSessionId: null,
            questions: [],
            answers: new Map(),
            currentView: 'selection',

            setSession(sessionId, questions) {
                this.currentSessionId = sessionId;
                this.questions = questions;
                this.answers = new Map();
                questions.forEach(q => {
                    this.answers.set(q.questionId, {
                        questionId: q.questionId,
                        answerText: '',
                        isValid: false
                    });
                });
                this.persist();
            },

            persist() {
                const answerData = {};
                this.answers.forEach((v, k) => {
                    answerData[k] = v;
                });
                localStorage.setItem('interviewPageState', JSON.stringify({
                    currentSessionId: this.currentSessionId,
                    questions: this.questions,
                    answers: answerData,
                    savedAt: new Date().toISOString()
                }));
            },

            updateAnswer(questionId, answerText) {
                const answer = this.answers.get(questionId);
                if (answer) {
                    answer.answerText = answerText;
                    answer.isValid = answerText.trim().length >= 10;
                    this.answers.set(questionId, answer);
                    this.persist();
                }
            },

            getAnsweredCount() {
                let count = 0;
                this.answers.forEach(a => {
                    if (a.answerText.trim().length > 0) count++;
                });
                return count;
            },

            getAllAnswers() {
                const result = [];
                this.answers.forEach(a => {
                    result.push({
                        interviewQuestionId: a.questionId,
                        answerText: a.answerText
                    });
                });
                return result;
            },

            clear() {
                this.currentSessionId = null;
                this.questions = [];
                this.answers = new Map();
                localStorage.removeItem('interviewPageState');
            },

            getQuestion(questionId) {
                return this.questions.find(q => q.questionId === questionId);
            },

            getQuestionsByCategory(category) {
                return this.questions.filter(q =>
                    q.category?.toLowerCase() === category.toLowerCase()
                );
            }
        };

        // ============================================
        // Initialize Page
        // ============================================
        document.addEventListener('DOMContentLoaded', async function() {
            await loadTargetJobs();
            await loadSkillGapAnalyses();
        });

        // Load target jobs
        async function loadTargetJobs() {
            const token = localStorage.getItem("token");
            const select = document.getElementById("targetJobSelect");
            const emptyMessage = document.getElementById("noTargetJobsMessage");

            try {
                const response = await axios.get(`${API_BASE_URL}/TargetJobs/my`, {
                    headers: { "Authorization": `Bearer ${token}` }
                });

                select.innerHTML = '<option value="">-- Select Target Job --</option>';

                if (response.data && response.data.length > 0) {
                    response.data.forEach(job => {
                        const option = document.createElement('option');
                        option.value = job.id;
                        option.textContent = `${job.jobTitle} ${job.company ? '- ' + job.company : ''}`;
                        select.appendChild(option);
                    });
                    emptyMessage.style.display = 'none';
                    select.style.display = 'block';
                } else {
                    select.innerHTML = '<option value="">No target jobs available</option>';
                    select.style.display = 'none';
                    emptyMessage.style.display = 'flex';
                }
            } catch (error) {
                console.error('Failed to load target jobs:', error);
                showToast("Cannot load target jobs.", "error");
            }
        }

        // Load skill gap analyses
        async function loadSkillGapAnalyses() {
            const token = localStorage.getItem("token");
            const select = document.getElementById("skillGapSelect");
            const emptyMessage = document.getElementById("noAnalysesMessage");

            try {
                const response = await axios.get(`${API_BASE_URL}/SkillGapAnalysis/my-analyses`, {
                    headers: { "Authorization": `Bearer ${token}` }
                });

                select.innerHTML = '<option value="">-- Select Analysis --</option>';

                if (response.data && response.data.length > 0) {
                    response.data.forEach(analysis => {
                        const option = document.createElement('option');
                        option.value = analysis.id;
                        const readinessScore = analysis.readinessScore ?? 0;
                        const date = analysis.createdAt 
                            ? new Date(analysis.createdAt).toLocaleDateString() 
                            : 'N/A';
                        option.textContent = `Analysis #${analysis.id} - Readiness: ${readinessScore}% (${date})`;
                        select.appendChild(option);
                    });
                    emptyMessage.style.display = 'none';
                    select.style.display = 'block';
                } else {
                    select.innerHTML = '<option value="">-- Select Analysis --</option>';
                    select.style.display = 'none';
                    emptyMessage.innerHTML = `
                        <i class="fas fa-info-circle"></i>
                        No Skill Gap Analysis found.
                        Please run Skill Gap Analysis first.
                        <a href="/SkillGap" class="text-ai-primary ml-2">Go to Analysis →</a>
                    `;
                    emptyMessage.style.display = 'flex';
                }
            } catch (error) {
                console.error('Failed to load analyses:', error);
                select.innerHTML = '<option value="">-- Select Analysis --</option>';
                select.style.display = 'none';
                emptyMessage.innerHTML = `
                    <i class="fas fa-info-circle"></i>
                    No Skill Gap Analysis found.
                    Please run Skill Gap Analysis first.
                    <a href="/SkillGap" class="text-ai-primary ml-2">Go to Analysis →</a>
                `;
                emptyMessage.style.display = 'flex';
            }
        }

        // Start mock interview
        async function startMockInterview() {
            const targetJobId = document.getElementById("targetJobSelect").value;
            const skillGapAnalysisId = document.getElementById("skillGapSelect").value;

            if (!targetJobId) {
                showToast("Please select a target job.", "error");
                return;
            }

            if (!skillGapAnalysisId) {
                showToast("Please select a skill gap analysis.", "error");
                return;
            }

            hideAllViews();
            showView('loading');
            setButtonLoading(true);

            const token = localStorage.getItem("token");

            try {
                const response = await axios.post(
                    `${API_BASE_URL}/MockInterviews/generate`,
                    {
                        targetJobId: parseInt(targetJobId),
                        skillGapAnalysisId: parseInt(skillGapAnalysisId)
                    },
                    {
                        headers: {
                            "Content-Type": "application/json",
                            "Authorization": `Bearer ${token}`
                        }
                    }
                );

                displayResults(response.data);
            } catch (error) {
                console.error('Interview generation failed:', error);
                showError(error);
            } finally {
                setButtonLoading(false);
            }
        }

        // Display results
        function displayResults(data) {
            console.log("[DISPLAY 1] entered");
            console.log("displayResults data:", data);

            hideAllViews();
            console.log("[DISPLAY 2] after hideAllViews");

            InterviewPageState.setSession(data.sessionId, data.questions);
            console.log("[DISPLAY 3] after setSession");

            document.getElementById("sessionBadge").textContent = `Session #${data.sessionId}`;
            document.getElementById("summaryJobTitle").textContent = data.targetJob?.title || "N/A";
            document.getElementById("summarySessionId").textContent = data.sessionId;
            const chatSessionMeta = document.getElementById("chatSessionMeta");
            if (chatSessionMeta) {
                chatSessionMeta.textContent = `${data.targetJob?.title || "Mock Interview"} · Session #${data.sessionId}`;
            }
            updateInterviewClock();

            const fallbackBadge = document.getElementById("fallbackBadge");
            fallbackBadge.style.display = data.isFallback ? "inline-flex" : "none";

            document.getElementById("statTotal").textContent = data.questions?.length || 0;

            const grouped = {
                Technical: [],
                Behavioral: [],
                Communication: []
            };

            data.questions.forEach(q => {
                const category = q.category || "Technical";
                if (grouped[category]) {
                    grouped[category].push(q);
                } else {
                    grouped.Technical.push(q);
                }
            });

            document.getElementById("statTechnical").textContent = grouped.Technical.length;
            document.getElementById("statBehavioral").textContent = grouped.Behavioral.length;
            document.getElementById("statCommunication").textContent = grouped.Communication.length;

            renderCategorySection("technical", "Technical", grouped.Technical);
            renderCategorySection("behavioral", "Behavioral", grouped.Behavioral);
            renderCategorySection("communication", "Communication", grouped.Communication);

            showAnswerForm();
            console.log("[DISPLAY 4] after showAnswerForm");
        }

        // Show answer form
        function showAnswerForm() {
            hideAllViews();
            showView('answer');
            renderAnswerQuestions();
            updateAnswerProgress();
        }

        // Render answer questions
        function renderAnswerQuestions() {
            const container = document.getElementById("answerQuestionsContainer");
            container.innerHTML = '';

            InterviewPageState.questions.forEach((q, index) => {
                const answerCard = createAnswerCard(q, index + 1);
                container.appendChild(answerCard);
            });
        }

        // Create answer card
        function createAnswerCard(question, index) {
            const card = document.createElement("div");
            card.className = "chat-question-pair";
            card.dataset.questionId = question.questionId;

            const category = question.category?.toLowerCase() || "technical";
            const existingAnswer = InterviewPageState.answers.get(question.questionId);
            const isAnswered = existingAnswer?.answerText?.trim()?.length > 0;

            card.innerHTML = `
                <div class="chat-message-row ai">
                    <div class="message-avatar-ai"></div>
                    <div class="message-bubble-ai">
                        <div class="message-bubble-label">
                            <span>${question.category || 'Technical'}</span>
                            <span>Q${index}</span>
                        </div>
                        <div>${question.questionContent}</div>
                        ${question.skillArea ? `
                            <div class="mt-3">
                                <span class="badge-ai badge-ai-info badge-ai-sm">
                                    <i class="fas fa-star mr-1"></i>
                                    Skill Focus: ${question.skillArea}
                                </span>
                            </div>
                        ` : ''}
                    </div>
                </div>
                <div class="chat-message-row user">
                    <div class="message-avatar-user">
                        <i class="fas fa-user"></i>
                    </div>
                    <div class="message-bubble-user">
                        <div class="message-bubble-label">
                            <span>Câu trả lời của bạn</span>
                            <span class="answer-status-indicator ${isAnswered ? 'answered' : 'pending'}">
                                ${isAnswered 
                                    ? '<i class="fas fa-check-circle"></i> Answered' 
                                    : '<i class="fas fa-clock"></i> Pending'}
                            </span>
                        </div>
                        <textarea 
                            id="answer-${question.questionId}"
                            class="chat-answer-input"
                            rows="5"
                            placeholder="Type your answer here... (minimum 10 characters for best results)"
                            oninput="handleAnswerInput(${question.questionId}, this.value)"
                        >${existingAnswer?.answerText || ''}</textarea>
                        <div class="chat-answer-footer">
                            <span class="char-count-text">
                                <span id="chars-${question.questionId}">${existingAnswer?.answerText?.length || 0}</span> characters
                            </span>
                            <span id="validation-${question.questionId}" class="char-validation ${existingAnswer?.isValid ? 'valid' : 'invalid'}">
                                ${existingAnswer?.isValid 
                                    ? '<i class="fas fa-check"></i> Valid' 
                                    : '<i class="fas fa-info-circle"></i> Min 10 chars'}
                            </span>
                        </div>
                    </div>
                </div>
            `;

            return card;
        }

        // Handle answer input
        function handleAnswerInput(questionId, value) {
            InterviewPageState.updateAnswer(questionId, value);

            const charsSpan = document.getElementById(`chars-${questionId}`);
            const validationSpan = document.getElementById(`validation-${questionId}`);
            const statusIndicator = document.querySelector(`[data-question-id="${questionId}"] .answer-status-indicator`);
            const answer = InterviewPageState.answers.get(questionId);

            if (charsSpan) charsSpan.textContent = value.length;

            if (validationSpan) {
                if (value.trim().length >= 10) {
                    validationSpan.className = 'char-validation valid';
                    validationSpan.innerHTML = '<i class="fas fa-check"></i> Valid';
                } else {
                    validationSpan.className = 'char-validation invalid';
                    validationSpan.innerHTML = `<i class="fas fa-info-circle"></i> ${10 - value.trim().length > 0 ? (10 - value.trim().length) + ' more needed' : 'Min 10 chars'}`;
                }
            }

            if (statusIndicator) {
                if (value.trim().length > 0) {
                    statusIndicator.className = 'answer-status-indicator answered';
                    statusIndicator.innerHTML = '<i class="fas fa-check-circle"></i> Answered';
                } else {
                    statusIndicator.className = 'answer-status-indicator pending';
                    statusIndicator.innerHTML = '<i class="fas fa-clock"></i> Pending';
                }
            }

            updateAnswerProgress();
        }

        // Update answer progress
        function updateAnswerProgress() {
            const total = InterviewPageState.questions.length;
            const answered = InterviewPageState.getAnsweredCount();
            const progressEl = document.getElementById("answerProgress");
            if (progressEl) {
                progressEl.textContent = `${answered}/${total} Answered`;
            }
        }

        // Submit all answers
        async function submitAllAnswers() {
            const answers = InterviewPageState.getAllAnswers();
            const total = InterviewPageState.questions.length;
            const answered = InterviewPageState.getAnsweredCount();

            if (answered === 0) {
                showValidationMessage("Please answer at least one question before submitting.");
                return;
            }

            const unanswered = total - answered;
            if (unanswered > 0) {
                const confirmSubmit = confirm(
                    `You have ${unanswered} unanswered question${unanswered > 1 ? 's' : ''}. ` +
                    `Do you want to submit only the ${answered} answered question${answered > 1 ? 's' : ''}?`
                );
                if (!confirmSubmit) return;
            }

            hideValidationMessage();
            setSubmitButtonLoading(true);

            const token = localStorage.getItem("token");
            const sessionId = InterviewPageState.currentSessionId;

            try {
                const submittedAnswers = answers.filter(a => a.answerText.trim().length > 0);
                
                for (const answer of submittedAnswers) {
                    await axios.post(
                        `${API_BASE_URL}/interviews/${sessionId}/answers`,
                        {
                            interviewQuestionId: answer.interviewQuestionId,
                            answerText: answer.answerText
                        },
                        {
                            headers: {
                                "Content-Type": "application/json",
                                "Authorization": `Bearer ${token}`
                            }
                        }
                    );
                }

                showSuccess(submittedAnswers.length);
            } catch (error) {
                console.error('Failed to submit answers:', error);
                showToast("Failed to submit answers. Please try again.", "error");
            } finally {
                setSubmitButtonLoading(false);
            }
        }

        // Show validation message
        function showValidationMessage(message) {
            const el = document.getElementById("validationMessage");
            const text = document.getElementById("validationText");
            if (el && text) {
                text.textContent = message;
                el.style.display = 'flex';
            }
        }

        // Hide validation message
        function hideValidationMessage() {
            const el = document.getElementById("validationMessage");
            if (el) el.style.display = 'none';
        }

        // Show success
        function showSuccess(answerCount) {
            hideValidationMessage();
            document.getElementById("successState").style.display = "block";

            const feedbackBtn = document.getElementById("viewFeedbackBtn");
            if (feedbackBtn) {
                feedbackBtn.href = `/Feedback?sessionId=${InterviewPageState.currentSessionId}`;
            }

            const submitBtn = document.getElementById("submitAnswersBtn");
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-check mr-2"></i>Submitted';
            }
        }

        function updateInterviewClock() {
            const clock = document.getElementById("interviewClock");
            if (!clock) return;
            const now = new Date();
            clock.textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }

        // View management
        function hideAllViews() {
            document.getElementById("selectionCard").style.display = "none";
            document.getElementById("loadingState").style.display = "none";
            document.getElementById("resultsContainer").style.display = "none";
            document.getElementById("answerFormSection").style.display = "none";
            document.getElementById("errorState").style.display = "none";
            document.getElementById("successState").style.display = "none";
        }

        function showView(view) {
            InterviewPageState.currentView = view;
            switch (view) {
                case 'selection':
                    document.getElementById("selectionCard").style.display = "block";
                    break;
                case 'loading':
                    document.getElementById("loadingState").style.display = "block";
                    break;
                case 'results':
                    document.getElementById("resultsContainer").style.display = "block";
                    break;
                case 'answer':
                    document.getElementById("answerFormSection").style.display = "block";
                    break;
                case 'error':
                    document.getElementById("errorState").style.display = "flex";
                    break;
                case 'success':
                    document.getElementById("successState").style.display = "block";
                    break;
            }
        }

        // Render category section
        function renderCategorySection(sectionId, categoryName, questions) {
            const section = document.getElementById(`${sectionId}Section`);
            const container = document.getElementById(`${sectionId}Cards`);
            const countBadge = document.getElementById(`${sectionId}Count`);

            if (questions.length === 0) {
                section.style.display = "none";
                return;
            }

            section.style.display = "block";
            countBadge.textContent = questions.length;
            container.innerHTML = '';

            questions.forEach((q, index) => {
                const card = createQuestionCard(q, index + 1, categoryName);
                container.appendChild(card);
            });
        }

        // Create question card
        function createQuestionCard(question, index, category) {
            const categoryLower = category.toLowerCase();

            const card = document.createElement("div");
            card.className = "question-card-ai";
            card.dataset.questionId = question.questionId;
            card.dataset.category = category;
            card.dataset.skillFocus = question.skillArea || '';

            card.innerHTML = `
                <div class="question-card-header ${categoryLower}">
                    <span class="question-badge ${categoryLower}">
                        ${category}
                    </span>
                    <span class="question-number">#${question.questionId}</span>
                </div>
                <div class="question-card-body">
                    <h5 class="question-content">
                        <span class="text-ai-muted">Q${index}:</span> ${question.questionContent}
                    </h5>
                    <div class="question-meta">
                        ${question.skillArea ? `
                            <span class="badge-ai badge-ai-info badge-ai-sm">
                                <i class="fas fa-star mr-1"></i>
                                ${question.skillArea}
                            </span>
                        ` : ''}
                        ${question.difficulty ? `
                            <span class="badge-ai badge-ai-${getDifficultyColor(question.difficulty)} badge-ai-sm">
                                ${question.difficulty}
                            </span>
                        ` : ''}
                    </div>
                </div>
            `;

            return card;
        }

        function getDifficultyColor(difficulty) {
            const lower = difficulty?.toLowerCase() || "";
            if (lower.includes("beginner") || lower.includes("easy")) return "success";
            if (lower.includes("advanced") || lower.includes("hard")) return "danger";
            return "warning";
        }

        // Show error
        function showError(error) {
            hideAllViews();
            showView('error');

            let message = "An unexpected error occurred.";
            if (error.response?.data?.detail) {
                message = error.response.data.detail;
            } else if (error.message) {
                message = error.message;
            }

            document.getElementById("errorMessage").textContent = message;
        }

        // Reset to selection
        function resetToSelection() {
            hideAllViews();
            InterviewPageState.clear();
            showView('selection');
            document.getElementById("targetJobSelect").value = "";
            document.getElementById("skillGapSelect").value = "";
            loadTargetJobs();
            loadSkillGapAnalyses();
        }

        // Set button loading
        function setButtonLoading(loading) {
            const btn = document.getElementById("startInterviewButton");
            if (loading) {
                btn.disabled = true;
                btn.innerHTML = '<span class="loading-spinner-ai loading-spinner-ai-sm mr-2"></span>Generating...';
            } else {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-play mr-2"></i>Start Mock Interview';
            }
        }

        // Set submit button loading
        function setSubmitButtonLoading(loading) {
            const btn = document.getElementById("submitAnswersButton");
            if (loading) {
                btn.disabled = true;
                btn.innerHTML = '<span class="loading-spinner-ai loading-spinner-ai-sm mr-2"></span>Submitting...';
            } else {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-paper-plane mr-2"></i>Submit All Answers';
            }
        }
    </script>
}
