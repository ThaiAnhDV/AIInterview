@page
@model AIInterviewPlatform.Web.Pages.Profile.IndexModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 mx-auto">

            <div class="card shadow">
                <div class="card-header">
                    <h4 class="mb-0">My Profile</h4>
                </div>

                <div class="card-body">

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger">
                            @Model.ErrorMessage
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                    {
                        <div class="alert alert-success">
                            @Model.SuccessMessage
                        </div>
                    }

                    <form method="post">

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input class="form-control" value="@Model.Profile.Email" readonly />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Full Name</label>
                            <input asp-for="Profile.FullName" class="form-control" />
                            <span asp-validation-for="Profile.FullName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Phone</label>
                            <input asp-for="Profile.Phone" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Education Level</label>
                            <input asp-for="Profile.EducationLevel" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Career Goal</label>
                            <textarea asp-for="Profile.CareerGoal" class="form-control" rows="4"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">User Type</label>
                            <input class="form-control" value="@Model.Profile.UserType" readonly />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Status</label>
                            <input class="form-control" value="@Model.Profile.Status" readonly />
                        </div>

                        <button type="submit" class="btn btn-primary">
                            Save Changes
                        </button>

                        <a asp-page="/Index" class="btn btn-secondary">
                            Back
                        </a>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}