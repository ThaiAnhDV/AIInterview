@page
@{
    Layout = null;
    ViewData["Title"] = "Profile";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <title>Profile - AI Interview Platform</title>

    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700" rel="stylesheet">
    <link href="https://use.fontawesome.com/releases/v5.0.6/css/all.css" rel="stylesheet">

    <link href="/assets/css/nucleo-icons.css" rel="stylesheet" />
    <link href="/assets/css/nucleo-svg.css" rel="stylesheet" />
    <link href="/assets/css/font-awesome.css" rel="stylesheet" />
    <link href="/assets/css/argon-design-system.css?v=1.2.2" rel="stylesheet" />
    <link href="/css/site.css" rel="stylesheet" />
</head>

<body class="profile-page">

    <nav id="navbar-main" class="navbar navbar-main navbar-expand-lg navbar-transparent navbar-light py-2">
        <div class="container">
            <a class="navbar-brand mr-lg-5" href="/">
                <strong class="text-white">AI INTERVIEW PLATFORM</strong>
            </a>

            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbar_global">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="navbar-collapse collapse" id="navbar_global">
                <ul class="navbar-nav navbar-nav-hover align-items-lg-center">
                    <li class="nav-item">
                        <a href="/" class="nav-link">
                            <span class="nav-link-inner--text">Home</span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="/Profile" class="nav-link">
                            <span class="nav-link-inner--text">Profile</span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="/Resume" class="nav-link">
                            <span class="nav-link-inner--text">Resume</span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="#" class="nav-link">
                            <span class="nav-link-inner--text">Mock Interview</span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="#" class="nav-link">
                            <span class="nav-link-inner--text">Roadmap</span>
                        </a>
                    </li>
                </ul>

                <ul class="navbar-nav align-items-lg-center ml-lg-auto">
                    <li class="nav-item mr-3">
                        <span id="navbarUserName" class="text-white font-weight-bold"></span>
                    </li>

                    <li class="nav-item">
                        <button onclick="logout()" class="btn btn-danger btn-sm">
                            Logout
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="wrapper">
        <section class="section-profile-cover section-shaped my-0">
            <img class="bg-image" src="/assets/img/pages/mohamed.jpg" style="width: 100%;">

            <div class="separator separator-bottom separator-skew">
                <svg x="0" y="0" viewBox="0 0 2560 100" preserveAspectRatio="none">
                    <polygon class="fill-secondary" points="2560 0 2560 100 0 100"></polygon>
                </svg>
            </div>
        </section>

        <section class="section bg-secondary">
            <div class="container">
                <div class="card card-profile shadow mt--300">
                    <div class="px-4">

                        <div class="row justify-content-center">
                            <div class="col-lg-3 order-lg-2">
                                <div class="card-profile-image">
                                    <a href="javascript:;">
                                        <img src="/assets/img/faces/team-4.jpg" class="rounded-circle">
                                    </a>
                                </div>
                            </div>

                            <div class="col-lg-4 order-lg-3 text-lg-right align-self-lg-center">
                                <div class="card-profile-actions py-4 mt-lg-0">
                                    <a href="#" class="btn btn-sm btn-info mr-4">Dashboard</a>
                                    <a href="#" class="btn btn-sm btn-default float-right">Start Interview</a>
                                </div>
                            </div>

                            <div class="col-lg-4 order-lg-1">
                                <div class="card-profile-stats d-flex justify-content-center">
                                    <div>
                                        <span class="heading">0</span>
                                        <span class="description">Sessions</span>
                                    </div>
                                    <div>
                                        <span class="heading">0</span>
                                        <span class="description">Roadmaps</span>
                                    </div>
                                    <div>
                                        <span class="heading">0%</span>
                                        <span class="description">Readiness</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="text-center mt-5">
                            <h3 id="profileDisplayName">Loading...</h3>

                            <div class="h6 font-weight-300">
                                <i class="ni ni-email-83 mr-2"></i>
                                <span id="profileDisplayEmail">Loading...</span>
                            </div>

                            <div class="h6 mt-4">
                                <i class="ni business_briefcase-24 mr-2"></i>
                                AI Interview Platform User
                            </div>

                            <div>
                                <i class="ni education_hat mr-2"></i>
                                <span id="profileDisplayEducation">Preparing for better interviews</span>
                            </div>
                        </div>

                        <div class="mt-5 py-5 border-top">
                            <div class="row justify-content-center">
                                <div class="col-lg-9">

                                    <div class="text-center mb-4">
                                        <h4>Edit Profile</h4>
                                        <p class="text-muted">
                                            Update your personal interview preparation information.
                                        </p>
                                    </div>

                                    <form onsubmit="event.preventDefault(); updateProfile();">

                                        <div class="form-group">
                                            <label>Full Name</label>
                                            <input id="profileFullName"
                                                   class="form-control"
                                                   type="text"
                                                   placeholder="Full Name">
                                        </div>

                                        <div class="form-group">
                                            <label>Email</label>
                                            <input id="profileEmail"
                                                   class="form-control"
                                                   type="email"
                                                   readonly>
                                        </div>

                                        <div class="form-group">
                                            <label>Phone</label>
                                            <input id="profilePhone"
                                                   class="form-control"
                                                   type="text"
                                                   placeholder="Phone number">
                                        </div>

                                        <div class="form-group">
                                            <label>Education Level</label>
                                            <input id="profileEducationLevel"
                                                   class="form-control"
                                                   type="text"
                                                   placeholder="University, College, High School...">
                                        </div>

                                        <div class="form-group">
                                            <label>Career Goal</label>
                                            <textarea id="profileCareerGoal"
                                                      class="form-control"
                                                      rows="4"
                                                      placeholder="Example: Become a Backend Developer"></textarea>
                                        </div>

                                        <div class="text-center">
                                            <button type="submit" class="btn btn-primary">
                                                Save Profile
                                            </button>

                                            <a href="/" class="btn btn-secondary">
                                                Back to Home
                                            </a>
                                        </div>

                                    </form>

                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </section>
    </div>

    <footer class="footer">
        <div class="container">
            <hr>
            <div class="row align-items-center justify-content-md-between">
                <div class="col-md-6">
                    <div class="copyright">
                        &copy; 2026 AI Interview Platform
                    </div>
                </div>

                <div class="col-md-6">
                    <ul class="nav nav-footer justify-content-end">
                        <li class="nav-item">
                            <a href="/" class="nav-link">Home</a>
                        </li>
                        <li class="nav-item">
                            <a href="/Profile" class="nav-link">Profile</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>

    <script src="/assets/js/core/jquery.min.js"></script>
    <script src="/assets/js/core/popper.min.js"></script>
    <script src="/assets/js/core/bootstrap.min.js"></script>
    <script src="/assets/js/argon-design-system.min.js?v=1.2.2"></script>

    <script src="/js/api.js"></script>
    <script src="/js/site.js"></script>
    <script src="/js/auth.js"></script>
    <script src="/js/guard.js"></script>
    <script src="/js/profile.js"></script>

    <script>
        if (requireLogin()) {
            loadProfile();
        }
    </script>

</body>
</html>