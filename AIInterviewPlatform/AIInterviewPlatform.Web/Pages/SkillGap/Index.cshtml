@page
@model AIInterviewPlatform.Web.Pages.SkillGap.IndexModel

@{
    ViewData["Title"] = "Skill Gap Analysis";
}

<div class="container mt-4">

    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Skill Gap Analysis</h4>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label>Resume</label>
                    <select id="resumeSelect" class="form-control"></select>
                </div>

                <div class="col-md-6 mb-3">
                    <label>Target Job</label>
                    <select id="targetJobSelect" class="form-control"
                            onchange="loadJobDescriptionForSelectedJob()"></select>
                </div>

            </div>

            <input type="hidden" id="jobDescriptionId" />

            <button class="btn btn-success" onclick="runSkillGapAnalysis()">
                Analyze Skill Gap
            </button>

        </div>
    </div>

    <div id="analysisResult" class="card shadow-sm border-0 mt-4" style="display:none;">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Analysis Result</h5>
        </div>

        <div class="card-body">

            <h3>
                Readiness Score:
                <span id="readinessScore" class="text-primary"></span>%
            </h3>

            <hr />

            <h5>Matched Skills</h5>
            <div id="matchedSkillsContainer" class="mb-4"></div>

            <h5>Missing Skills</h5>
            <div id="missingSkillsContainer"></div>

        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/api.js"></script>
    <script src="~/js/site.js"></script>
    <script src="~/js/auth.js"></script>
    <script src="~/js/guard.js"></script>
    <script src="~/js/skill-gap.js"></script>

    <script>
        if (requireLogin()) {
            loadSkillGapPage();
        }
    </script>
}