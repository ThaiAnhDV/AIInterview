@page
@{
    Layout = null;
    ViewData["Title"] = "Resume";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <title>Resume - AI Interview Platform</title>

    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700" rel="stylesheet">
    <link href="https://use.fontawesome.com/releases/v5.0.6/css/all.css" rel="stylesheet">

    <link href="/assets/css/nucleo-icons.css" rel="stylesheet" />
    <link href="/assets/css/nucleo-svg.css" rel="stylesheet" />
    <link href="/assets/css/font-awesome.css" rel="stylesheet" />
    <link href="/assets/css/argon-design-system.css?v=1.2.2" rel="stylesheet" />
    <link href="/css/site.css" rel="stylesheet" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Open Sans', sans-serif;
            overflow-x: hidden;
            background: #0a0a1a;
            min-height: 100vh;
        }

        /* Video Background */
        .video-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            overflow: hidden;
        }

        .video-bg video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .video-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(10, 10, 26, 0.85);
            backdrop-filter: blur(5px);
        }

        /* Navbar */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            padding: 15px 0;
            background: rgba(10, 10, 26, 0.8);
            backdrop-filter: blur(10px);
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            flex-shrink: 0;
        }

        .navbar-brand img {
            height: 80px;
            width: auto;
        }

        .navbar-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            gap: 20px;
        }

        .navbar-center {
            display: flex;
            align-items: center;
            justify-content: center;
            flex: 1;
        }

        .navbar-auth-buttons {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
        }

        /* Pill Navigation */
        .pill-radio-container {
            --main-color: #ff6ec4;
            --secondary-color: #7873f5;
            --text-color: #ddd;
            --pill-bg: rgba(26, 26, 26, 0.6);
            --total-options: 5;

            display: flex;
            position: relative;
            background: var(--pill-bg);
            border-radius: 3rem;
            padding: 0.5rem;
            gap: 0.5rem;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.5) inset;
            width: fit-content;
            backdrop-filter: blur(10px);
        }

        .pill-radio-container input {
            display: none;
        }

        .pill-radio-container label {
            position: relative;
            padding: 0.6rem 1.2rem;
            border-radius: 3rem;
            cursor: pointer;
            font-weight: 600;
            color: var(--text-color);
            transition: color 0.3s ease-in-out;
            z-index: 2;
            white-space: nowrap;
            font-size: 14px;
        }

        .pill-radio-container input:checked + label {
            color: #fff;
        }

        .pill-radio-container label:hover {
            color: var(--main-color);
        }

        .pill-indicator {
            position: absolute;
            bottom: 5px;
            left: 0;
            height: 4px;
            width: calc(100% / var(--total-options));
            background: linear-gradient(
                to right,
                var(--main-color),
                var(--secondary-color)
            );
            border-radius: 2px;
            transition: transform 0.3s ease-in-out;
            z-index: 1;
        }

        /* Sliding effect for pill navigation */
        #pill-home:checked ~ .pill-indicator {
            transform: translateX(0%);
        }
        #pill-profile:checked ~ .pill-indicator {
            transform: translateX(100%);
        }
        #pill-resume:checked ~ .pill-indicator {
            transform: translateX(200%);
        }
        #pill-interview:checked ~ .pill-indicator {
            transform: translateX(300%);
        }
        #pill-roadmap:checked ~ .pill-indicator {
            transform: translateX(400%);
        }

        /* Action Buttons with Glow Effect */
        .button {
            position: relative;
            width: 120px;
            height: 40px;
            background-color: #000;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            flex-direction: column;
            border: none;
            padding: 12px;
            gap: 12px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            font-size: 14px;
            text-decoration: none;
            overflow: hidden;
            text-align: center;
            line-height: 1;
        }

        .button::before {
            content: '';
            position: absolute;
            inset: 0;
            left: -4px;
            top: -1px;
            margin: auto;
            width: 128px;
            height: 48px;
            border-radius: 10px;
            background: linear-gradient(-45deg, #e81cff 0%, #40c9ff 100%);
            z-index: -10;
            pointer-events: none;
            transition: all 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .button::after {
            content: "";
            z-index: -1;
            position: absolute;
            inset: 0;
            background: linear-gradient(-45deg, #fc00ff 0%, #00dbde 100%);
            transform: translate3d(0, 0, 0) scale(0.95);
            filter: blur(20px);
        }

        .button:hover::after {
            filter: blur(30px);
        }

        .button:hover::before {
            transform: rotate(-180deg);
        }

        .button:active::before {
            scale: 0.7;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .user-name {
            color: #fff;
            font-weight: 600;
        }

        /* Resume Content */
        .resume-content {
            padding-top: 140px;
            padding-bottom: 60px;
            min-height: 100vh;
            position: relative;
            z-index: 1;
        }

        .resume-card {
            background: rgba(20, 20, 40, 0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 40px;
            margin-bottom: 40px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
        }

        .resume-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .resume-title {
            color: #fff;
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .resume-subtitle {
            color: rgba(255, 255, 255, 0.7);
            font-size: 1rem;
        }

        /* Upload Section */
        .upload-section {
            background: rgba(30, 30, 60, 0.5);
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 30px;
        }

        .upload-section h4 {
            color: #fff;
            margin-bottom: 20px;
        }

        .upload-row {
            display: flex;
            gap: 15px;
            align-items: center;
            flex-wrap: wrap;
        }

        .upload-row input[type="file"] {
            flex: 1;
            min-width: 200px;
            padding: 15px 20px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px dashed rgba(255, 110, 196, 0.5);
            border-radius: 10px;
            color: #fff;
        }

        .upload-row input[type="file"]::file-selector-button {
            background: linear-gradient(135deg, #ff6ec4, #7873f5);
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            color: #fff;
            cursor: pointer;
            margin-right: 15px;
        }

        .btn-upload {
            padding: 15px 35px;
            background: linear-gradient(135deg, #ff6ec4, #7873f5);
            border: none;
            border-radius: 50px;
            color: #fff;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            white-space: nowrap;
        }

        .btn-upload:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(255, 110, 196, 0.4);
        }

        /* Table Styles */
        .resume-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        .resume-table th {
            color: rgba(255, 255, 255, 0.8);
            font-weight: 600;
            text-align: left;
            padding: 15px;
            border-bottom: 2px solid rgba(255, 110, 196, 0.3);
        }

        .resume-table td {
            color: rgba(255, 255, 255, 0.7);
            padding: 15px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .resume-table tr:hover {
            background: rgba(255, 255, 255, 0.05);
        }

        .status-badge {
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .status-active {
            background: rgba(76, 175, 80, 0.2);
            color: #4caf50;
        }

        .status-inactive {
            background: rgba(255, 152, 0, 0.2);
            color: #ff9800;
        }

        /* Bootstrap Button Overrides for Resume Actions */
        .btn {
            padding: 8px 15px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            font-weight: 600;
            font-size: 12px;
            margin-right: 5px;
            transition: all 0.3s ease;
        }

        .btn-sm {
            padding: 6px 12px;
            font-size: 11px;
        }

        .btn-info {
            background: rgba(64, 201, 255, 0.2);
            color: #40c9ff;
        }

        .btn-info:hover {
            background: rgba(64, 201, 255, 0.4);
            color: #fff;
        }

        .btn-primary {
            background: linear-gradient(135deg, rgba(255, 110, 196, 0.3), rgba(120, 115, 245, 0.3));
            color: #ff6ec4;
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, rgba(255, 110, 196, 0.5), rgba(120, 115, 245, 0.5));
            color: #fff;
        }

        .btn-danger {
            background: rgba(244, 67, 54, 0.2);
            color: #f44336;
        }

        .btn-danger:hover {
            background: rgba(244, 67, 54, 0.4);
            color: #fff;
        }

        .badge {
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        .badge-success {
            background: rgba(76, 175, 80, 0.2);
            color: #4caf50;
        }

        .badge-secondary {
            background: rgba(108, 117, 125, 0.2);
            color: #6c757d;
        }

        .action-btn {
            padding: 8px 15px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            font-weight: 600;
            font-size: 12px;
            margin-right: 5px;
            transition: all 0.3s ease;
        }

        .action-btn-view {
            background: rgba(64, 201, 255, 0.2);
            color: #40c9ff;
        }

        .action-btn-view:hover {
            background: rgba(64, 201, 255, 0.4);
        }

        .action-btn-delete {
            background: rgba(244, 67, 54, 0.2);
            color: #f44336;
        }

        .action-btn-delete:hover {
            background: rgba(244, 67, 54, 0.4);
        }

        /* Buttons */
        .btn-group {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin-top: 30px;
        }

        .btn-secondary-custom {
            padding: 15px 35px;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 50px;
            color: #fff;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .btn-secondary-custom:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateY(-3px);
        }

        /* Footer */
        footer {
            background: rgba(10, 10, 26, 0.95);
            padding: 40px 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            margin-top: 60px;
            position: relative;
            z-index: 1;
        }

        .footer-content {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .footer-copyright {
            color: rgba(255, 255, 255, 0.6);
            font-size: 14px;
        }

        .footer-links {
            display: flex;
            gap: 30px;
        }

        .footer-links a {
            color: rgba(255, 255, 255, 0.6);
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .footer-links a:hover {
            color: #ff6ec4;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: rgba(255, 255, 255, 0.5);
        }

        .empty-state i {
            font-size: 3rem;
            margin-bottom: 20px;
            color: rgba(255, 110, 196, 0.5);
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .pill-radio-container {
                flex-wrap: wrap;
                justify-content: center;
                --total-options: 3;
            }

            .pill-indicator {
                display: none;
            }

            .navbar-auth-buttons {
                display: none;
            }

            .user-info {
                display: none;
            }

            .upload-row {
                flex-direction: column;
            }

            .upload-row input[type="file"],
            .btn-upload {
                width: 100%;
            }

            .btn-group {
                flex-direction: column;
            }

            .footer-content {
                flex-direction: column;
                text-align: center;
            }

            .resume-table {
                font-size: 14px;
            }

            .resume-table th,
            .resume-table td {
                padding: 10px;
            }
        }
    </style>
</head>

<body>
    <!-- Video Background -->
    <div class="video-bg">
        <video autoplay muted loop playsinline>
            <source src="/videos/videoBackGoundHome.mp4" type="video/mp4">
        </video>
        <div class="video-overlay"></div>
    </div>

    <!-- Navbar -->
    <nav class="navbar">
        <div class="container">
            <div class="navbar-container">
                <a class="navbar-brand" href="/">
                    <img src="/img/logo.png" alt="Logo">
                </a>

                <div class="navbar-center">
                    <div class="pill-radio-container">
                        <input type="radio" name="pill" id="pill-home">
                        <label for="pill-home" onclick="window.location.href='/'">Home</label>

                        <input type="radio" name="pill" id="pill-profile">
                        <label for="pill-profile" onclick="window.location.href='/Profile'">Profile</label>

                        <input type="radio" name="pill" id="pill-resume" checked>
                        <label for="pill-resume" onclick="window.location.href='/Resume'">Resume</label>

                        <input type="radio" name="pill" id="pill-interview">
                        <label for="pill-interview">Interview</label>

                        <input type="radio" name="pill" id="pill-roadmap">
                        <label for="pill-roadmap">Roadmap</label>

                        <div class="pill-indicator"></div>
                    </div>
                </div>

                <div class="user-info">
                    <span id="currentUserName" class="user-name"></span>
                    <a id="logoutButton" href="#" onclick="logout(); return false;" class="button">
                        Logout
                    </a>
                </div>

                <div class="navbar-auth-buttons">
                    <a id="logoutButtonNew" href="#" onclick="logout(); return false;" class="button">
                        Logout
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Resume Content -->
    <div class="resume-content">
        <div class="container">
            <div class="resume-card">
                <div class="resume-header">
                    <h1 class="resume-title">Resume Management</h1>
                    <p class="resume-subtitle">Upload and manage your CV/resume for interview analysis.</p>
                </div>

                <div class="upload-section">
                    <h4><i class="fas fa-cloud-upload-alt mr-2"></i>Upload New Resume</h4>
                    <div class="upload-row">
                        <input id="resumeFile"
                               type="file"
                               accept=".pdf,.doc,.docx">
                        <button onclick="uploadResume()" class="btn-upload">
                            <i class="fas fa-upload mr-2"></i>Upload Resume
                        </button>
                    </div>
                </div>

                <h4 style="color: #fff; margin-bottom: 20px;"><i class="fas fa-list mr-2"></i>Your Resumes</h4>
                
                <div id="resumeListContainer">
                    <table class="resume-table">
                        <thead>
                            <tr>
                                <th>File Name</th>
                                <th>Status</th>
                                <th>Uploaded At</th>
                                <th>View</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="resumeTableBody">
                            <tr>
                                <td colspan="5" class="text-center text-muted" style="padding: 40px;">
                                    Loading resumes...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="btn-group">
                    <a href="/" class="btn-secondary-custom">
                        <i class="fas fa-home mr-2"></i>Back to Home
                    </a>
                    <a href="/Profile" class="btn-secondary-custom">
                        <i class="fas fa-user mr-2"></i>Go to Profile
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer>
        <div class="footer-content">
            <div class="footer-copyright">
                &copy; 2026 AI Interview Platform
            </div>
            <div class="footer-links">
                <a href="/">Home</a>
                <a href="/Profile">Profile</a>
                <a href="/Resume">Resume</a>
            </div>
        </div>
    </footer>

    <script src="/assets/js/core/jquery.min.js"></script>
    <script src="/assets/js/core/popper.min.js"></script>
    <script src="/assets/js/core/bootstrap.min.js"></script>
    <script src="/assets/js/plugins/perfect-scrollbar.jquery.min.js"></script>
    <script src="/assets/js/argon-design-system.min.js?v=1.2.2"></script>

    <script src="/js/api.js"></script>
    <script src="/js/site.js"></script>
    <script src="/js/auth.js"></script>
    <script src="/js/guard.js"></script>
    <script src="/js/resume.js"></script>

    <script>
        (function() {
            const token = localStorage.getItem("token");
            
            if (!token) {
                window.location.href = "/Auth/Login";
                return;
            }
            
            if (typeof loadResumes === 'function') {
                loadResumes();
            }
        })();
    </script>

</body>
</html>
