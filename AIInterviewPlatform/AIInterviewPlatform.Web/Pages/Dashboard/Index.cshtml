@page
@model AIInterviewPlatform.Web.Pages.Dashboard.IndexModel

@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .dashboard-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 24px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 32px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .page-header h1 {
        font-size: 1.75rem;
        font-weight: 700;
        color: #fff;
        margin: 0;
    }

    .page-header h1 i {
        background: linear-gradient(135deg, #ff6ec4, #7873f5);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .btn-refresh {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.7);
        padding: 10px 20px;
        border-radius: 10px;
        transition: all 0.3s ease;
    }

    .btn-refresh:hover {
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
        border-color: rgba(255, 110, 196, 0.3);
    }

    .btn-refresh i {
        transition: transform 0.3s ease;
    }

    .btn-refresh:hover i {
        transform: rotate(180deg);
    }

    /* Loading State */
    .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 400px;
        text-align: center;
    }

    .spinner-lg {
        width: 60px;
        height: 60px;
        border: 4px solid rgba(255, 255, 255, 0.1);
        border-top-color: #ff6ec4;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    /* Error State */
    .error-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 60vh;
        text-align: center;
        padding: 60px 40px;
    }

    .error-icon {
        width: 100px;
        height: 100px;
        background: linear-gradient(135deg, rgba(244, 67, 54, 0.2), rgba(244, 67, 54, 0.1));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 28px;
        animation: error-pulse 2s ease-in-out infinite;
    }

    @@keyframes error-pulse {
        0%, 100% {
            box-shadow: 0 0 20px rgba(244, 67, 54, 0.2);
        }
        50% {
            box-shadow: 0 0 35px rgba(244, 67, 54, 0.35);
        }
    }

    .error-icon i {
        font-size: 2.5rem;
        color: #f44336;
    }

    .error-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 12px;
    }

    .error-description {
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.6);
        max-width: 380px;
        margin-bottom: 8px;
        line-height: 1.6;
    }

    .error-code {
        display: inline-block;
        padding: 4px 12px;
        background: rgba(244, 67, 54, 0.15);
        border: 1px solid rgba(244, 67, 54, 0.25);
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        color: #f44336;
        margin-bottom: 24px;
    }

    .error-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        justify-content: center;
        margin-top: 8px;
    }

    .btn-retry {
        background: linear-gradient(135deg, #ff6ec4, #7873f5);
        border: none;
        color: #fff;
        padding: 12px 28px;
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-retry:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(255, 110, 196, 0.35);
        color: #fff;
    }

    .btn-retry i {
        transition: transform 0.3s ease;
    }

    .btn-retry:hover i {
        transform: rotate(180deg);
    }

    .btn-retry:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }

    .btn-login-error {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: rgba(255, 255, 255, 0.8);
        padding: 12px 28px;
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

    .btn-login-error:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(120, 115, 245, 0.5);
        color: #fff;
    }

    .error-spinner {
        width: 20px;
        height: 20px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    /* Dashboard Grid */
    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: rgba(25, 25, 50, 0.8);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        padding: 24px;
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-4px);
        border-color: rgba(255, 110, 196, 0.2);
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
    }

    .stat-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .stat-icon i {
        font-size: 1.25rem;
    }

    .stat-icon.blue {
        background: rgba(64, 201, 255, 0.15);
        color: #40c9ff;
    }

    .stat-icon.purple {
        background: rgba(120, 115, 245, 0.15);
        color: #7873f5;
    }

    .stat-icon.pink {
        background: rgba(255, 110, 196, 0.15);
        color: #ff6ec4;
    }

    .stat-icon.green {
        background: rgba(76, 175, 80, 0.15);
        color: #4caf50;
    }

    .stat-value {
        font-size: 2.5rem;
        font-weight: 700;
        color: #fff;
        line-height: 1;
        margin-bottom: 4px;
    }

    .stat-label {
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.5);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Content Grid */
    .content-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 24px;
    }

    /* Readiness Score Card */
    .readiness-card {
        background: rgba(25, 25, 50, 0.8);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 24px;
    }

    .readiness-header {
        background: linear-gradient(135deg, rgba(255, 110, 196, 0.2), rgba(120, 115, 245, 0.2));
        padding: 20px 24px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .readiness-header h4 {
        color: #fff;
        margin: 0;
        font-size: 1rem;
    }

    .readiness-header small {
        color: rgba(255, 255, 255, 0.6);
    }

    .readiness-body {
        padding: 24px;
    }

    .readiness-score-container {
        display: flex;
        align-items: center;
        gap: 40px;
    }

    .circular-progress {
        position: relative;
        width: 140px;
        height: 140px;
    }

    .circular-progress svg {
        transform: rotate(-90deg);
    }

    .circular-progress circle {
        fill: none;
        stroke-width: 10;
    }

    .circular-bg {
        stroke: rgba(255, 255, 255, 0.1);
    }

    .circular-progress circle {
        stroke-linecap: round;
        transition: stroke-dashoffset 1s ease;
    }

    .progress-value {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
    }

    .progress-value .value {
        font-size: 2.5rem;
        font-weight: 700;
        color: #fff;
        line-height: 1;
    }

    .progress-value .max {
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.4);
    }

    .readiness-details {
        flex: 1;
    }

    .trend-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 20px;
        margin-bottom: 16px;
    }

    .trend-badge.badge-success {
        background: rgba(76, 175, 80, 0.15);
        color: #4caf50;
        border: 1px solid rgba(76, 175, 80, 0.3);
    }

    .trend-badge.badge-danger {
        background: rgba(244, 67, 54, 0.15);
        color: #f44336;
        border: 1px solid rgba(244, 67, 54, 0.3);
    }

    .trend-badge.badge-secondary {
        background: rgba(255, 255, 255, 0.08);
        color: rgba(255, 255, 255, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.15);
    }

    .score-comparison {
        display: flex;
        gap: 24px;
    }

    .score-item {
        text-align: center;
    }

    .score-item .label {
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.4);
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .score-item .value {
        font-size: 1.5rem;
        font-weight: 700;
        color: #fff;
    }

    /* Skill Gap Card */
    .skill-gap-card {
        background: rgba(25, 25, 50, 0.8);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 24px;
    }

    .skill-gap-header {
        background: rgba(30, 30, 60, 0.9);
        padding: 20px 24px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .skill-gap-header h4 {
        color: #fff;
        margin: 0;
        font-size: 1rem;
    }

    .skill-gap-body {
        padding: 24px;
    }

    .priority-stats {
        display: flex;
        gap: 16px;
        margin-bottom: 20px;
    }

    .priority-stat {
        flex: 1;
        text-align: center;
        padding: 12px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
    }

    .priority-stat .count {
        font-size: 1.5rem;
        font-weight: 700;
    }

    .priority-stat .label {
        font-size: 0.7rem;
        color: rgba(255, 255, 255, 0.5);
        text-transform: uppercase;
    }

    .priority-stat.critical .count { color: #f44336; }
    .priority-stat.high .count { color: #ff9800; }
    .priority-stat.medium .count { color: #2196f3; }
    .priority-stat.low .count { color: #9e9e9e; }

    .skill-gap-item {
        padding: 16px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .skill-gap-item:last-child {
        border-bottom: none;
    }

    .skill-gap-item h6 {
        font-size: 0.95rem;
    }

    /* Roadmap Progress Card */
    .roadmap-card {
        background: rgba(25, 25, 50, 0.8);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 24px;
    }

    .roadmap-header {
        background: linear-gradient(135deg, rgba(120, 115, 245, 0.2), rgba(255, 110, 196, 0.2));
        padding: 20px 24px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .roadmap-header h4 {
        color: #fff;
        margin: 0 0 4px 0;
        font-size: 1rem;
    }

    .roadmap-header small {
        color: rgba(255, 255, 255, 0.6);
    }

    .roadmap-body {
        padding: 24px;
    }

    .roadmap-stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 20px;
    }

    .roadmap-stat {
        text-align: center;
        padding: 16px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
    }

    .roadmap-stat .value {
        font-size: 2rem;
        font-weight: 700;
        color: #fff;
    }

    .roadmap-stat .label {
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.5);
        text-transform: uppercase;
    }

    /* Recent Feedback Card */
    .feedback-card {
        background: rgba(25, 25, 50, 0.8);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        overflow: hidden;
    }

    .feedback-header {
        background: rgba(30, 30, 60, 0.9);
        padding: 20px 24px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .feedback-header h4 {
        color: #fff;
        margin: 0;
        font-size: 1rem;
    }

    .feedback-body {
        padding: 24px;
        max-height: 500px;
        overflow-y: auto;
    }

    .feedback-item {
        padding: 16px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .feedback-item:last-child {
        border-bottom: none;
    }

    .feedback-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .feedback-meta {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* Interview Stats Card */
    .interview-card {
        background: rgba(25, 25, 50, 0.8);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 24px;
    }

    .interview-header {
        background: rgba(30, 30, 60, 0.9);
        padding: 20px 24px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .interview-header h4 {
        color: #fff;
        margin: 0;
        font-size: 1rem;
    }

    .interview-body {
        padding: 24px;
    }

    .interview-stats-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }

    .interview-stat {
        padding: 16px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
        text-align: center;
    }

    .interview-stat .value {
        font-size: 1.75rem;
        font-weight: 700;
        color: #fff;
    }

    .interview-stat .label {
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.5);
        text-transform: uppercase;
    }

    /* Empty State */
    .empty-state-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 60vh;
        text-align: center;
        padding: 60px 40px;
    }

    .empty-state-icon {
        width: 120px;
        height: 120px;
        background: linear-gradient(135deg, rgba(255, 110, 196, 0.15), rgba(120, 115, 245, 0.15));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 32px;
        animation: pulse-glow 3s ease-in-out infinite;
    }

    @@keyframes pulse-glow {
        0%, 100% {
            box-shadow: 0 0 20px rgba(255, 110, 196, 0.2);
        }
        50% {
            box-shadow: 0 0 40px rgba(255, 110, 196, 0.4);
        }
    }

    .empty-state-icon i {
        font-size: 3rem;
        background: linear-gradient(135deg, #ff6ec4, #7873f5);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .empty-state-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 12px;
    }

    .empty-state-description {
        font-size: 1rem;
        color: rgba(255, 255, 255, 0.6);
        max-width: 400px;
        margin-bottom: 32px;
        line-height: 1.6;
    }

    .empty-state-actions {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .btn-upload-resume {
        background: linear-gradient(135deg, #ff6ec4, #7873f5);
        border: none;
        color: #fff;
        padding: 14px 28px;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .btn-upload-resume:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(255, 110, 196, 0.4);
        color: #fff;
    }

    .btn-analyze-skill {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: rgba(255, 255, 255, 0.8);
        padding: 14px 28px;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .btn-analyze-skill:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(120, 115, 245, 0.5);
        color: #fff;
        transform: translateY(-2px);
    }

    /* Responsive */
    @@media (max-width: 1200px) {
        .dashboard-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .content-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .dashboard-page {
            padding: 16px;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .dashboard-grid {
            grid-template-columns: 1fr;
        }

        .readiness-score-container {
            flex-direction: column;
        }

        .roadmap-stats-grid {
            grid-template-columns: 1fr;
        }

        /* Error State Responsive */
        .error-container {
            padding: 40px 20px;
            min-height: 50vh;
        }

        .error-icon {
            width: 80px;
            height: 80px;
        }

        .error-icon i {
            font-size: 2rem;
        }

        .error-title {
            font-size: 1.25rem;
        }

        .error-description {
            font-size: 0.9rem;
            padding: 0 10px;
        }

        .error-actions {
            flex-direction: column;
            width: 100%;
        }

        .error-actions .btn-retry,
        .error-actions .btn-login-error {
            width: 100%;
            justify-content: center;
        }

        .priority-stats {
            flex-wrap: wrap;
        }

        .priority-stat {
            flex: 1 1 40%;
        }

        .empty-state-container {
            padding: 40px 20px;
        }

        .empty-state-icon {
            width: 100px;
            height: 100px;
        }

        .empty-state-icon i {
            font-size: 2.5rem;
        }

        .empty-state-title {
            font-size: 1.5rem;
        }

        .empty-state-actions {
            flex-direction: column;
            width: 100%;
        }

        .empty-state-actions .btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <h2>
            <i class="fas fa-chart-pie"></i>
            Dashboard
        </h2>
        <button class="btn-refresh" onclick="refreshDashboard()">
            <i class="fas fa-sync-alt mr-2"></i>
            Refresh
        </button>
    </div>

    <!-- Loading State -->
    <div id="dashboardLoading" class="loading-container" style="display: none;">
        <div class="spinner-lg"></div>
        <p class="text-muted mt-4">Loading dashboard...</p>
    </div>

    <!-- Error State -->
    <div id="dashboardError" class="error-container" style="display: none;">
        <div class="error-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <h4 class="error-title">Unable to load dashboard data</h4>
        <p class="error-description">Something went wrong while loading your dashboard.</p>
        <span id="errorCode" class="error-code" style="display: none;"></span>
        <div class="error-actions">
            <button id="retryButton" class="btn-retry" onclick="retryDashboard()">
                <i class="fas fa-redo"></i>
                Retry
            </button>
            <a id="loginButton" href="/Auth/Login" class="btn-login-error" style="display: none;">
                <i class="fas fa-sign-in-alt"></i>
                Login
            </a>
        </div>
    </div>

    <!-- Empty State -->
    <div id="dashboardEmpty" class="empty-state-container" style="display: none;">
        <div class="empty-state-icon">
            <i class="fas fa-chart-line"></i>
        </div>
        <h2 class="empty-state-title">No Dashboard Data Yet</h2>
        <p class="empty-state-description">
            Upload your resume and complete a Skill Gap Analysis to start tracking your progress.
        </p>
        <div class="empty-state-actions">
            <button class="btn-upload-resume" onclick="navigateToUpload()">
                <i class="fas fa-file-alt"></i>
                My Resume
            </button>
            <button class="btn-analyze-skill" onclick="navigateToSkillGap()">
                <i class="fas fa-search"></i>
                Analyze Skill Gap
            </button>
        </div>
    </div>

    <!-- Dashboard Content -->
    <div id="dashboardContent">
        <!-- KPI Stats Grid -->
        <div class="dashboard-grid">
            <!-- Readiness Score Card -->
            <div class="stat-card">
                <div class="stat-card-header">
                    <div class="stat-icon pink">
                        <i class="fas fa-bullseye"></i>
                    </div>
                </div>
                <div class="stat-value" id="kpiReadinessScore">-</div>
                <div class="stat-label">Readiness Score</div>
            </div>

            <!-- Missing Skills Card -->
            <div class="stat-card">
                <div class="stat-card-header">
                    <div class="stat-icon purple">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                </div>
                <div class="stat-value" id="missingSkillsCount">-</div>
                <div class="stat-label">Missing Skills</div>
            </div>

            <!-- Total Interviews Card -->
            <div class="stat-card">
                <div class="stat-card-header">
                    <div class="stat-icon blue">
                        <i class="fas fa-comments"></i>
                    </div>
                </div>
                <div class="stat-value" id="totalInterviews">-</div>
                <div class="stat-label">Total Interviews</div>
            </div>

            <!-- Average Score Card -->
            <div class="stat-card">
                <div class="stat-card-header">
                    <div class="stat-icon green">
                        <i class="fas fa-star"></i>
                    </div>
                </div>
                <div class="stat-value" id="averageScore">-</div>
                <div class="stat-label">Avg Score</div>
            </div>
        </div>

        <!-- Content Grid -->
        <div class="content-grid">
            <!-- Left Column -->
            <div>
                <!-- Readiness Score Card -->
                <div class="readiness-card">
                    <div class="readiness-header">
                        <h4>
                            <i class="fas fa-chart-line mr-2"></i>
                            Readiness Score
                        </h4>
                        <small>Based on your latest analysis</small>
                    </div>
                    <div class="readiness-body">
                        <div class="readiness-score-container">
                            <div class="circular-progress">
                                <svg width="140" height="140">
                                    <circle class="circular-bg" cx="70" cy="70" r="54"></circle>
                                    <circle id="readinessProgressCircle" class="circular-fg" cx="70" cy="70" r="54"
                                        stroke-dasharray="339.292" stroke-dashoffset="339.292"></circle>
                                </svg>
                                <div class="progress-value">
                                    <div class="value" id="readinessScoreValue2">-</div>
                                    <div class="max">/ 100</div>
                                </div>
                            </div>
                            <div class="readiness-details">
                                <span id="readinessTrend" class="badge badge-secondary">
                                    <i class="fas fa-minus mr-1"></i> Loading...
                                </span>
                                <p id="readinessImprovement" class="text-muted mt-2 mb-3">-</p>
                                <div class="score-comparison">
                                    <div class="score-item">
                                        <div class="label">Current</div>
                                        <div class="value" id="readinessScoreValue3">-</div>
                                    </div>
                                    <div class="score-item">
                                        <div class="label">Previous</div>
                                        <div class="value" id="previousScore">-</div>
                                    </div>
                                </div>
                                <small class="text-muted mt-3 d-block">
                                    Last updated: <span id="lastUpdated">-</span>
                                </small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Skill Gap Card -->
                <div class="skill-gap-card">
                    <div class="skill-gap-header">
                        <h4>
                            <i class="fas fa-layer-group mr-2"></i>
                            Skill Gap Analysis
                        </h4>
                        <a href="/SkillGap" class="btn-secondary-ai btn-sm">
                            <i class="fas fa-external-link-alt mr-1"></i>
                            View All
                        </a>
                    </div>
                    <div class="skill-gap-body">
                        <div class="priority-stats">
                            <div class="priority-stat critical">
                                <div class="count" id="highPriorityCount">0</div>
                                <div class="label">Critical</div>
                            </div>
                            <div class="priority-stat high">
                                <div class="count" id="mediumPriorityCount">0</div>
                                <div class="label">High</div>
                            </div>
                            <div class="priority-stat medium">
                                <div class="count" id="lowPriorityCount">0</div>
                                <div class="label">Medium</div>
                            </div>
                        </div>
                        <div id="missingSkillsList">
                            <!-- Skills will be populated by JavaScript -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column -->
            <div>
                <!-- Interview Stats Card -->
                <div class="interview-card">
                    <div class="interview-header">
                        <h4>
                            <i class="fas fa-microphone-alt mr-2"></i>
                            Interview Stats
                        </h4>
                    </div>
                    <div class="interview-body">
                        <div class="interview-stats-grid">
                            <div class="interview-stat">
                                <div class="value" id="completedInterviews">0</div>
                                <div class="label">Completed</div>
                            </div>
                            <div class="interview-stat">
                                <div class="value" id="pendingInterviews">0</div>
                                <div class="label">Pending</div>
                            </div>
                            <div class="interview-stat">
                                <div class="value" id="highestScore">-</div>
                                <div class="label">Highest</div>
                            </div>
                            <div class="interview-stat">
                                <div class="value" id="lowestScore">-</div>
                                <div class="label">Lowest</div>
                            </div>
                        </div>
                        <div class="mt-3 text-center">
                            <a href="/Interview" class="btn-primary-ai">
                                <i class="fas fa-play mr-2"></i>
                                Start Interview
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Roadmap Progress Card -->
                <div class="roadmap-card">
                    <div class="roadmap-header">
                        <div>
                            <h4>
                                <i class="fas fa-map-marked-alt mr-2"></i>
                                Learning Roadmap
                            </h4>
                            <small id="activeRoadmapTitle">-</small>
                        </div>
                    </div>
                    <div class="roadmap-body" id="roadmapStats">
                        <div class="roadmap-stats-grid">
                            <div class="roadmap-stat">
                                <div class="value" id="totalRoadmaps">0</div>
                                <div class="label">Roadmaps</div>
                            </div>
                            <div class="roadmap-stat">
                                <div class="value" id="overallProgress">0%</div>
                                <div class="label">Progress</div>
                            </div>
                            <div class="roadmap-stat">
                                <div class="value">
                                    <span id="completedMilestones">0</span>/<span id="totalMilestones">0</span>
                                </div>
                                <div class="label">Milestones</div>
                            </div>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div id="roadmapProgressBar" class="progress-bar" style="width: 0%;"></div>
                        </div>
                        <div class="mt-3 text-center">
                            <a href="/Roadmap" class="btn btn-primary">
                                <i class="fas fa-map mr-2"></i>
                                View Roadmap
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Recent Feedback Card -->
                <div class="feedback-card">
                    <div class="feedback-header">
                        <h4>
                            <i class="fas fa-comment-dots mr-2"></i>
                            Recent Feedback
                        </h4>
                    </div>
                    <div class="feedback-body" id="recentFeedbackList">
                        <!-- Feedback items will be populated by JavaScript -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/guard.js"></script>
    <script src="~/js/dashboard.js"></script>
    <script>
        console.log("Dashboard JS loaded");

        document.addEventListener('DOMContentLoaded', function() {
            console.log("DOMContentLoaded fired");
            console.log("typeof loadDashboard =", typeof loadDashboard);
            try {
                if (typeof loadDashboard === 'function') {
                    if (requireLogin()) {
                        console.log("requireLogin returned true, calling loadDashboard");
                        loadDashboard();
                    } else {
                        console.log("requireLogin returned false");
                    }
                } else {
                    console.error("loadDashboard is not a function!");
                }
            } catch (ex) {
                console.error("Dashboard startup failed:", ex);
            }
        });
    </script>
}
